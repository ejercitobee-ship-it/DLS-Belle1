{% schema %}
{
  "name": "Hero Banner",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "Crafted for the Discerning Few"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>The World's Finest<br><em>Humidor Collections</em></p>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Dunn's Luxury Selections brings together the most exceptional humidors and cigar accessories in the world — curated for collectors, lounges, and connoisseurs who settle for nothing but the best.</p>"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary CTA Text",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary CTA Text",
      "default": "Bespoke Solutions"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show Trust Badges",
      "default": true
    }
  ]
}
{% endschema %}

<section class="hero">
  {%- if section.settings.background_image -%}
    <div class="hero-background">
      <img
        src="{{ section.settings.background_image | img_url: '1920x1080' }}"
        alt="Hero background"
        class="hero-image"
      />
      <div class="hero-overlay"></div>
    </div>
  {%- else -%}
    <div class="hero-overlay-only"></div>
  {%- endif -%}

  <div class="hero-content">
    <div class="max-w-2xl">
      {%- if section.settings.eyebrow_text != blank -%}
        <div class="hero-eyebrow">
          <div class="eyebrow-line"></div>
          <span class="eyebrow-text">{{ section.settings.eyebrow_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <div class="rte hero-heading">
          {{ section.settings.heading }}
        </div>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="rte hero-subheading">
          {{ section.settings.subheading }}
        </div>
      {%- endif -%}

      {%- if section.settings.cta_primary_text != blank or section.settings.cta_secondary_text != blank -%}
        <div class="hero-ctas">
          {%- if section.settings.cta_primary_text != blank -%}
            <a href="{{ section.settings.cta_primary_url }}" class="btn btn-primary">
              {{ section.settings.cta_primary_text }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.cta_secondary_text != blank -%}
            <a href="{{ section.settings.cta_secondary_url }}" class="btn btn-secondary">
              {{ section.settings.cta_secondary_text }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_trust_badges -%}
        <div class="hero-badges">
          <div class="hero-badge">
            <div class="hero-badge-icon">
              <svg fill="currentColor" viewBox="0 0 24 24" width="16" height="16">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
            <div>
              <div class="hero-badge-label">Curated Luxury</div>
              <div class="hero-badge-sub">Handpicked collections</div>
            </div>
          </div>

          <div class="hero-badge">
            <div class="hero-badge-icon">
              <svg fill="currentColor" viewBox="0 0 24 24" width="16" height="16">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
            <div>
              <div class="hero-badge-label">Authenticity Guaranteed</div>
              <div class="hero-badge-sub">Certified products</div>
            </div>
          </div>

          <div class="hero-badge">
            <div class="hero-badge-icon">
              <svg fill="currentColor" viewBox="0 0 24 24" width="16" height="16">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
            <div>
              <div class="hero-badge-label">Expert Concierge Support</div>
              <div class="hero-badge-sub">Free on select items</div>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.background_image == blank -%}
    <div class="hero-decorative-line"></div>
  {%- endif -%}
</section>

{% stylesheet %}
.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hero-background {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.hero-overlay,
.hero-overlay-only {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(33, 30, 28, 0.95) 0%, rgba(61, 54, 52, 0.75) 100%),
              linear-gradient(180deg, rgba(33, 30, 28, 0) 0%, rgba(33, 30, 28, 0.7) 100%);
}

.hero-overlay-only {
  background: linear-gradient(135deg, rgba(33, 30, 28, 0.95) 0%, rgba(61, 54, 52, 0.75) 100%);
}

.hero-decorative-line {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 1px;
  background: linear-gradient(to bottom, transparent, rgba(201, 138, 16, 0.6), transparent);
}

.hero-content {
  position: relative;
  max-width: 80rem;
  margin: 0 auto;
  padding: 5rem 1rem;
  width: 100%;
  z-index: 1;
}

@media (min-width: 640px) {
  .hero-content {
    padding: 6rem 1.5rem;
  }
}

@media (min-width: 1024px) {
  .hero-content {
    padding: 6rem 2rem;
  }
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.eyebrow-line {
  width: 2.5rem;
  height: 1px;
  background-color: var(--gold-500);
}

.eyebrow-text {
  color: var(--gold-400);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.4em;
  text-transform: uppercase;
}

.hero-heading {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(2rem, 5vw, 4rem);
  font-weight: 700;
  line-height: 1.1;
  color: white;
  margin-bottom: 1rem;
}

.hero-heading em {
  background: linear-gradient(135deg, var(--gold-500) 0%, var(--gold-200) 50%, var(--gold-600) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-style: italic;
}

.hero-subheading {
  color: rgba(240, 221, 184, 0.7);
  font-size: 1rem;
  line-height: 1.6;
  margin-bottom: 2rem;
  max-width: 32rem;
}

.hero-ctas {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 2.5rem;
  max-width: 28rem;
}

@media (min-width: 640px) {
  .hero-ctas {
    flex-direction: row;
  }
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1rem 1.75rem;
  border-radius: 0.375rem;
  font-weight: 600;
  font-size: 0.75rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(135deg, var(--gold-600) 0%, var(--gold-500) 50%, var(--gold-700) 100%);
  color: var(--charcoal-950);
  box-shadow: 0 4px 12px rgba(201, 138, 16, 0.3);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(201, 138, 16, 0.4);
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-secondary {
  border: 2px solid var(--gold-500);
  color: var(--gold-400);
  background: transparent;
}

.btn-secondary:hover {
  background-color: rgba(201, 138, 16, 0.1);
  border-color: var(--gold-400);
}

.hero-badges {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-width: 30rem;
}

@media (min-width: 640px) {
  .hero-badges {
    gap: 2rem;
  }
}

.hero-badge {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.hero-badge-icon {
  width: 2.25rem;
  height: 2.25rem;
  border: 1px solid rgba(201, 138, 16, 0.4);
  border-radius: 9999px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--gold-500);
}

.hero-badge-label {
  color: white;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.05em;
}

.hero-badge-sub {
  color: rgba(240, 221, 184, 0.5);
  font-size: 0.6875rem;
}

.rte {
  font-size: inherit;
  line-height: inherit;
}

.rte p {
  margin: 0;
}

.max-w-2xl {
  max-width: 42rem;
}
{% endstylesheet %}
