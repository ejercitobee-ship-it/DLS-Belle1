{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay Updated"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Get exclusive access to new arrivals, insider tips, and special offers</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Email Placeholder",
      "default": "Enter your email"
    }
  ]
}
{% endschema %}

<section class="newsletter-section">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="newsletter-container">
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="rte newsletter-description">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      <form class="newsletter-form" method="POST" action="/contact">
        <input type="hidden" name="form_type" value="customer" />
        <input type="hidden" name="utf8" value="✓" />

        <div class="newsletter-input-group">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder_text }}"
            required
            class="newsletter-input"
            aria-label="Email address"
          />
          <button type="submit" class="newsletter-button">
            {{ section.settings.button_text }}
          </button>
        </div>

        <p class="newsletter-consent">
          We respect your privacy. Unsubscribe at any time.
        </p>
      </form>
    </div>
  </div>
</section>

{% stylesheet %}
.newsletter-section {
  background: linear-gradient(135deg, var(--charcoal-900) 0%, var(--charcoal-800) 100%);
  border-top: 1px solid rgba(201, 138, 16, 0.2);
  border-bottom: 1px solid rgba(201, 138, 16, 0.2);
}

.newsletter-container {
  text-align: center;
}

.newsletter-heading {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(1.75rem, 5vw, 2.5rem);
  font-weight: 700;
  color: white;
  margin-bottom: 1rem;
}

.newsletter-description {
  color: rgba(240, 221, 184, 0.7);
  font-size: 1rem;
  line-height: 1.6;
  margin-bottom: 2rem;
  max-width: 40rem;
  margin-left: auto;
  margin-right: auto;
}

.newsletter-description p {
  margin: 0;
}

.newsletter-form {
  max-width: 28rem;
  margin: 0 auto;
}

.newsletter-input-group {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

@media (min-width: 640px) {
  .newsletter-input-group {
    flex-direction: row;
    gap: 0;
  }
}

.newsletter-input {
  flex: 1;
  padding: 0.75rem 1rem;
  background-color: var(--charcoal-950);
  border: 1px solid rgba(70, 62, 59, 0.6);
  border-right: none;
  color: var(--cream-100);
  font-size: 0.95rem;
  font-family: 'Inter', system-ui, sans-serif;
  outline: none;
  transition: all 0.3s ease;
}

.newsletter-input::placeholder {
  color: rgba(240, 221, 184, 0.4);
}

.newsletter-input:focus {
  border-color: var(--gold-500);
  box-shadow: 0 0 0 3px rgba(201, 138, 16, 0.1);
}

@media (max-width: 640px) {
  .newsletter-input {
    border-right: 1px solid rgba(70, 62, 59, 0.6);
  }
}

.newsletter-button {
  padding: 0.75rem 1.5rem;
  background: linear-gradient(135deg, var(--gold-600) 0%, var(--gold-500) 50%, var(--gold-700) 100%);
  color: var(--charcoal-950);
  border: none;
  border-left: 1px solid var(--gold-600);
  font-weight: 600;
  font-size: 0.85rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: 'Inter', system-ui, sans-serif;
}

@media (max-width: 640px) {
  .newsletter-button {
    border-left: none;
    width: 100%;
  }
}

.newsletter-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(201, 138, 16, 0.3);
}

.newsletter-button:active {
  transform: scale(0.98);
}

.newsletter-consent {
  color: rgba(240, 221, 184, 0.4);
  font-size: 0.75rem;
  margin: 0;
}

.rte {
  font-size: inherit;
}

.rte p {
  margin: 0;
}

.max-w-3xl {
  max-width: 48rem;
  margin-left: auto;
  margin-right: auto;
}
{% endstylesheet %}
