{% schema %}
{
  "name": "Order Summary",
  "class": "section-order-summary",
  "settings": []
}
{% endschema %}

<div class="order-summary">
  <div class="summary-card">
    <h2 class="summary-title">Order Summary</h2>

    <!-- Line Items Total -->
    <div class="summary-row">
      <span class="summary-label">Subtotal</span>
      <span class="summary-value">{{ cart.subtotal_price | money }}</span>
    </div>

    <!-- Shipping -->
    <div class="summary-row">
      <span class="summary-label">Shipping</span>
      <span class="summary-value">
        {%- if cart.requires_shipping -%}
          {% if cart.shipping_price > 0 %}
            {{ cart.shipping_price | money }}
          {% else %}
            Calculated at checkout
          {% endif %}
        {%- else -%}
          FREE
        {%- endif -%}
      </span>
    </div>

    <!-- Tax -->
    <div class="summary-row">
      <span class="summary-label">Tax</span>
      <span class="summary-value">Calculated at checkout</span>
    </div>

    <!-- Divider -->
    <div class="summary-divider"></div>

    <!-- Total -->
    <div class="summary-row total">
      <span class="summary-label">Total</span>
      <span class="summary-value">{{ cart.total_price | money }}</span>
    </div>

    <!-- Checkout Button -->
    <form action="/cart/checkout" method="POST" class="checkout-form">
      <button type="submit" class="btn btn-primary btn-lg">
        Proceed to Checkout
      </button>
    </form>

    <!-- Shop Pay -->
    {{ content_for_additional_checkout_buttons }}

    <!-- Trust Message -->
    <div class="trust-message">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 1C6.48 1 2 5.48 2 11s4.48 10 10 10 10-4.48 10-10S17.52 1 12 1zm-2 15l-5-5 1.41-1.41L10 13.17l7.59-7.59L19 7l-9 9z"/>
      </svg>
      <span>Secure checkout powered by Shopify</span>
    </div>

    <!-- Continue Shopping -->
    <a href="/collections/all" class="continue-shopping">
      ← Continue Shopping
    </a>
  </div>

  <!-- Financing Message -->
  {%- if cart.total_price >= 150000 -%}
    <div class="financing-message">
      <div class="financing-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 4V2m-8 2V2M2 11h20"></path>
        </svg>
      </div>
      <div class="financing-text">
        <p class="financing-title">Shop Pay Installments Available</p>
        <p class="financing-desc">Pay in 4 interest-free payments at checkout</p>
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.order-summary {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.summary-card {
  background-color: var(--charcoal-900);
  border: 1px solid rgba(70, 62, 59, 0.4);
  border-radius: 0.75rem;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.summary-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: white;
  margin: 0 0 0.5rem 0;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 0;
  color: rgba(240, 221, 184, 0.7);
  font-size: 0.95rem;
}

.summary-row.total {
  padding: 1rem 0;
  font-weight: 700;
  font-size: 1.1rem;
  color: white;
  border-top: 1px solid rgba(70, 62, 59, 0.4);
  margin-top: 0.5rem;
}

.summary-label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.summary-value {
  text-align: right;
}

.summary-divider {
  height: 1px;
  background-color: rgba(70, 62, 59, 0.4);
  margin: 0.5rem 0;
}

.checkout-form {
  width: 100%;
  margin-top: 0.5rem;
}

.order-summary .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.5rem;
  border-radius: 0.375rem;
  font-weight: 600;
  font-size: 0.85rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;
  width: 100%;
}

.btn-primary {
  background: linear-gradient(135deg, var(--gold-600) 0%, var(--gold-500) 50%, var(--gold-700) 100%);
  color: var(--charcoal-950);
  box-shadow: 0 4px 12px rgba(201, 138, 16, 0.3);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(201, 138, 16, 0.4);
}

.btn-lg {
  padding: 1rem 1.5rem;
  font-size: 0.9rem;
}

.trust-message {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: rgba(240, 221, 184, 0.5);
  font-size: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(70, 62, 59, 0.4);
}

.trust-message svg {
  color: var(--gold-500);
  flex-shrink: 0;
}

.continue-shopping {
  text-align: center;
  color: var(--gold-400);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.85rem;
  padding-top: 0.75rem;
  transition: color 0.3s ease;
}

.continue-shopping:hover {
  color: var(--gold-300);
}

.financing-message {
  background-color: rgba(201, 138, 16, 0.08);
  border: 1px solid rgba(201, 138, 16, 0.2);
  border-radius: 0.5rem;
  padding: 1rem;
  display: flex;
  gap: 0.75rem;
  align-items: flex-start;
}

.financing-icon {
  width: 2rem;
  height: 2rem;
  border-radius: 0.375rem;
  background-color: rgba(201, 138, 16, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold-500);
  flex-shrink: 0;
}

.financing-text {
  flex: 1;
}

.financing-title {
  color: white;
  font-weight: 600;
  font-size: 0.9rem;
  margin: 0 0 0.25rem 0;
}

.financing-desc {
  color: rgba(240, 221, 184, 0.6);
  font-size: 0.8rem;
  margin: 0;
}

/* Shop Pay Button */
:global(.shopify-payment-button) {
  margin-top: 1rem !important;
}

:global(.shopify-payment-button__button) {
  width: 100% !important;
  background-color: var(--charcoal-800) !important;
  border: 1px solid rgba(201, 138, 16, 0.3) !important;
  border-radius: 0.375rem !important;
}

:global(.shopify-payment-button__button:hover) {
  background-color: var(--charcoal-700) !important;
}
{% endstylesheet %}
