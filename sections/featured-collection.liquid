{% schema %}
{
  "name": "Featured Collection",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest. Acquisitions."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "Discover our handpicked selection of premium humidors"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "number",
      "id": "products_to_show",
      "label": "Number of products",
      "default": 3
    }
  ]
}
{% endschema %}

<section class="featured-collection">
  {%- if section.settings.heading != blank -%}
    <div class="featured-collection__header">
      <h2 class="featured-collection__heading">
        {%- assign heading_parts = section.settings.heading | split: ". " -%}
        {%- if heading_parts.size == 2 -%}
          <span class="heading-main">{{ heading_parts[0] }}.</span>
          <span class="heading-accent-text">{{ heading_parts[1] }}</span>
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h2>
      {%- if section.settings.description != blank -%}
        <div class="featured-collection__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.collection != blank -%}
    {%- assign collection = section.settings.collection -%}
    {%- assign sorted_products = collection.products | sort: 'price' | reverse -%}

    <div class="featured-collection__products product-grid">
      {%- for product in sorted_products limit: section.settings.products_to_show -%}
        <div class="product-grid__item">
          {%- render 'product-card', product: product -%}
        </div>
      {%- endfor -%}
    </div>
  {%- elsif collections.all.products.size > 0 -%}
    {%- assign sorted_products = collections.all.products | sort: 'price' | reverse -%}

    <div class="featured-collection__products product-grid">
      {%- for product in sorted_products limit: section.settings.products_to_show -%}
        <div class="product-grid__item">
          {%- render 'product-card', product: product -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.featured-collection {
  width: 100%;
}

.featured-collection__header {
  text-align: center;
  margin-bottom: 3rem;
}

.featured-collection__heading {
  display: block;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin-bottom: 1rem;
}

.heading-main {
  display: inline;
  color: #ffffff;
  font-style: normal;
}

.heading-accent-text {
  display: inline;
  color: #d4a373;
  font-style: italic;
  margin-left: 0.5rem;
}

.featured-collection__description {
  font-size: 1rem;
  color: rgba(240, 221, 184, 0.7);
  max-width: 600px;
  margin: 0 auto;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  align-items: stretch;
}

.product-grid__item {
  display: flex;
  flex-direction: column;
  height: 100%;
}

@media (max-width: 768px) {
  .product-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .featured-collection__heading {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
  }
}
{% endstylesheet %}
