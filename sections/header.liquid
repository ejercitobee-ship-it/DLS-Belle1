<!-- Announcement Bar (replicates headless site) -->
<div class="announcement-bar">
  Expert Consultation Available &mdash; <a href="tel:8884319214">Call (888) 431-9214</a>
</div>

<header class="header">
  <div class="header-container">
    <!-- Logo (image, matching the headless navbar) -->
    <a href="/" class="logo logo--image" aria-label="Dunn's Luxury Selections — Home">
      <img
        src="{{ 'logo.png' | asset_url }}"
        alt="Dunn's Luxury Selections"
        class="logo-img"
        width="240"
        height="80"
      />
    </a>

    <!-- Desktop Menu (mirrors the headless site's navigation) -->
    <nav class="primary-nav">
      <ul class="nav-menu">
        <li class="nav-item nav-dropdown">
          <a href="{{ routes.collections_url }}" class="nav-dropdown-toggle">
            Collections
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/collections/cabinet-humidors">Cabinet Humidors</a></li>
            <li><a href="/collections/desktop-humidors">Desktop Humidors</a></li>
            <li><a href="/collections/electronic-humidors">Electronic Humidors</a></li>
            <li><a href="/collections/travel-humidors">Travel Humidors</a></li>
            <li><a href="/collections/accessories-1">Accessories</a></li>
            <li><a href="/pages/walk-in-humidor">Bespoke Humidors</a></li>
            <li><a href="/collections/all">All Products</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a href="/pages/walk-in-humidor">Bespoke Humidors</a>
        </li>
        <li class="nav-item">
          <a href="/collections/new-arrivals">New Arrivals</a>
        </li>
        <li class="nav-item">
          <a href="/blogs/news">Journal</a>
        </li>
        <li class="nav-item">
          <a href="/pages/about-us">About</a>
        </li>
      </ul>
    </nav>

    <!-- Right Section: Search + Cart -->
    <div class="header-actions flex items-center gap-6">
      <!-- Search -->
      <div class="search-wrap">
        <button
          type="button"
          class="search-icon-link"
          id="search-toggle"
          aria-label="Search"
          aria-expanded="false"
          aria-controls="search-panel"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <div class="search-panel" id="search-panel" hidden>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel-form">
            <svg class="search-panel-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              name="q"
              id="header-search-input"
              placeholder="Search products..."
              autocomplete="off"
              aria-label="Search products"
              class="search-panel-input"
            />
            <button type="button" class="search-panel-close" id="search-close" aria-label="Close search">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </form>
          <div class="search-results" id="search-results" aria-live="polite"></div>
        </div>
      </div>

      <!-- Account -->
      <a
        href="{{ routes.account_url }}"
        class="account-icon-link"
        aria-label="{% if customer %}Your account{% else %}Sign in{% endif %}"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        {%- if customer -%}
          <span class="account-greeting">{{ customer.first_name | default: 'Account' }}</span>
        {%- endif -%}
      </a>

      <button
        class="cart-icon-container"
        id="cart-toggle"
        aria-label="Open shopping cart"
      >
        <svg class="cart-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span class="cart-count" id="cart-count"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </button>

      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
        <svg class="mobile-menu-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Panel -->
  <div class="mobile-nav" id="mobile-nav" hidden>
    <a href="/collections/cabinet-humidors">Cabinet Humidors</a>
    <a href="/collections/desktop-humidors">Desktop Humidors</a>
    <a href="/collections/electronic-humidors">Electronic Humidors</a>
    <a href="/collections/travel-humidors">Travel Humidors</a>
    <a href="/collections/accessories-1">Accessories</a>
    <a href="/pages/walk-in-humidor">Bespoke Humidors</a>
    <a href="/collections/new-arrivals">New Arrivals</a>
    <a href="/blogs/news">Journal</a>
    <a href="/pages/about-us">About</a>
    <a href="{{ routes.account_url }}">{% if customer %}My Account{% else %}Sign In{% endif %}</a>
    <a href="/collections/all" class="mobile-nav-cta">Shop All Humidors</a>
  </div>
</header>

<div class="mobile-nav-backdrop" id="mobile-nav-backdrop" hidden></div>

<style>
  .logo--image {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    height: 3rem;
    width: auto;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .logo-img { height: 5rem; }
  }

  .announcement-bar {
    background: linear-gradient(135deg, var(--gold-600) 0%, var(--gold-500) 50%, var(--gold-700) 100%);
    color: var(--charcoal-950);
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.45rem 1rem;
  }

  .announcement-bar a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    padding: 0.5rem 0;
    margin: 0;
    list-style: none;
    background: var(--charcoal-900);
    border: 1px solid rgba(201, 138, 16, 0.25);
    border-radius: 0.5rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 40;
  }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-menu li a {
    display: block;
    padding: 0.55rem 1.25rem;
    color: rgba(240, 221, 184, 0.85);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .dropdown-menu li a:hover {
    color: var(--gold-400);
    background: rgba(201, 138, 16, 0.08);
  }

  /* ── Search ─────────────────────────────────────────────── */
  .search-wrap {
    position: relative;
    display: inline-flex;
  }

  .search-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: rgba(240, 221, 184, 0.85);
    transition: color 0.2s ease;
  }

  .search-icon-link svg { flex-shrink: 0; }

  .mobile-menu-icon { flex-shrink: 0; }

  .cart-count[hidden] { display: none !important; }

  .search-icon-link:hover {
    color: var(--gold-400);
  }

  .account-icon-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: rgba(240, 221, 184, 0.85);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .account-icon-link:hover { color: var(--gold-400); }
  .account-icon-link svg { flex-shrink: 0; }
  .account-greeting {
    display: none;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .account-greeting { display: inline; }
  }

  .search-panel {
    position: absolute;
    top: calc(100% + 1rem);
    right: 0;
    width: 340px;
    max-width: calc(100vw - 2rem);
    background: var(--charcoal-900);
    border: 1px solid rgba(201, 138, 16, 0.3);
    border-radius: 0.6rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    z-index: 60;
    overflow: hidden;
  }

  .search-panel-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid rgba(70, 62, 59, 0.5);
  }

  .search-panel-icon { color: rgba(240, 221, 184, 0.4); flex-shrink: 0; }

  .search-panel-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--cream-100);
    font-size: 0.9rem;
  }

  .search-panel-input::placeholder { color: rgba(240, 221, 184, 0.4); }

  .search-panel-close {
    display: inline-flex;
    background: none;
    border: none;
    padding: 0.15rem;
    cursor: pointer;
    color: rgba(240, 221, 184, 0.5);
    transition: color 0.2s ease;
  }
  .search-panel-close:hover { color: var(--gold-400); }

  .search-results { max-height: 22rem; overflow-y: auto; }

  .search-result-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.65rem 0.85rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(70, 62, 59, 0.35);
    transition: background 0.2s ease;
  }
  .search-result-item:last-child { border-bottom: none; }
  .search-result-item:hover { background: rgba(201, 138, 16, 0.08); }

  .search-result-item img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 0.3rem;
    background: var(--charcoal-800);
    flex-shrink: 0;
  }

  .search-result-title {
    color: var(--cream-100);
    font-size: 0.85rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-result-price { color: var(--gold-400); font-size: 0.8rem; margin-top: 0.15rem; }

  .search-empty, .search-all-link {
    display: block;
    padding: 0.85rem;
    text-align: center;
    font-size: 0.85rem;
    color: rgba(240, 221, 184, 0.55);
  }
  .search-all-link {
    color: var(--gold-400);
    text-decoration: none;
    font-weight: 600;
    border-top: 1px solid rgba(70, 62, 59, 0.5);
  }
  .search-all-link:hover { background: rgba(201, 138, 16, 0.08); }

  /* ── Mobile navigation ──────────────────────────────────── */
  .mobile-nav {
    display: none;
    flex-direction: column;
    background: var(--charcoal-950);
    border-top: 1px solid rgba(70, 62, 59, 0.4);
    padding: 0.5rem 1.5rem 1.25rem;
  }

  .mobile-nav.open { display: flex; }

  .mobile-nav a {
    padding: 0.9rem 0.25rem;
    color: rgba(240, 221, 184, 0.85);
    font-size: 1rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(70, 62, 59, 0.4);
    transition: color 0.2s ease;
  }
  .mobile-nav a:hover { color: var(--gold-400); }

  .mobile-nav-cta {
    margin-top: 1rem;
    text-align: center;
    border: none !important;
    border-radius: 0.4rem;
    background: linear-gradient(135deg, var(--gold-500) 0%, var(--gold-600) 50%, var(--gold-700) 100%);
    color: var(--charcoal-950) !important;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.85rem !important;
  }
  .mobile-nav-cta:hover { color: var(--charcoal-950) !important; opacity: 0.92; }

  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 30;
  }

  @media (min-width: 768px) {
    .mobile-nav,
    .mobile-nav.open,
    .mobile-nav-backdrop { display: none !important; }
  }

  /* Bigger tap targets for header icons on phones (icons were 22-24px).
     Padding expands the hit area; a slightly tighter gap keeps the row balanced. */
  @media (max-width: 767px) {
    .header-actions { gap: 1rem; }
    .search-icon-link,
    .account-icon-link,
    .cart-icon-container,
    .mobile-menu-btn { padding: 0.5rem; }
  }
</style>
