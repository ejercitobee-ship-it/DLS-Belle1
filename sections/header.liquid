<!-- Announcement Bar (replicates headless site) -->
<div class="announcement-bar">
  Expert Consultation Available &mdash; <a href="tel:8884319214">Call (888) 431-9214</a>
</div>

<header class="header">
  <div class="header-container">
    <!-- Logo -->
    <a href="/" class="logo">Dunn's</a>

    <!-- Desktop Menu (mirrors the headless site's navigation) -->
    <nav>
      <ul class="nav-menu">
        <li class="nav-item nav-dropdown">
          <a href="{{ routes.collections_url }}" class="nav-dropdown-toggle">
            Collections
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/collections/cabinet-humidors">Cabinet Humidors</a></li>
            <li><a href="/collections/desktop-humidors">Desktop Humidors</a></li>
            <li><a href="/collections/electronic-humidors">Electronic Humidors</a></li>
            <li><a href="/collections/travel-humidors">Travel Humidors</a></li>
            <li><a href="/collections/accessories">Accessories</a></li>
            <li><a href="/pages/walk-in-humidor">Bespoke Humidors</a></li>
            <li><a href="/collections/all">All Products</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a href="/pages/walk-in-humidor">Bespoke Humidors</a>
        </li>
        <li class="nav-item">
          <a href="/collections/new-arrivals">New Arrivals</a>
        </li>
        <li class="nav-item">
          <a href="/blogs/news">Journal</a>
        </li>
        <li class="nav-item">
          <a href="/pages/about">About</a>
        </li>
      </ul>
    </nav>

    <!-- Right Section: Search + Cart -->
    <div class="flex items-center gap-6">
      <a href="{{ routes.search_url }}" class="search-icon-link" aria-label="Search">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <button
        class="cart-icon-container"
        id="cart-toggle"
        aria-label="Open shopping cart"
      >
        <svg class="cart-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </button>
    </div>

    <!-- Mobile Menu Button -->
    <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 24px; height: 24px;">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<style>
  .announcement-bar {
    background: linear-gradient(135deg, var(--gold-600) 0%, var(--gold-500) 50%, var(--gold-700) 100%);
    color: var(--charcoal-950);
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.45rem 1rem;
  }

  .announcement-bar a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    padding: 0.5rem 0;
    margin: 0;
    list-style: none;
    background: var(--charcoal-900);
    border: 1px solid rgba(201, 138, 16, 0.25);
    border-radius: 0.5rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 40;
  }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-menu li a {
    display: block;
    padding: 0.55rem 1.25rem;
    color: rgba(240, 221, 184, 0.85);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .dropdown-menu li a:hover {
    color: var(--gold-400);
    background: rgba(201, 138, 16, 0.08);
  }

  .search-icon-link {
    display: inline-flex;
    align-items: center;
    color: rgba(240, 221, 184, 0.85);
    transition: color 0.2s ease;
  }

  .search-icon-link:hover {
    color: var(--gold-400);
  }

  @media (max-width: 768px) {
    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      border: none;
      box-shadow: none;
      background: transparent;
      padding-left: 1rem;
    }
  }
</style>

<script>
  document.getElementById('cart-toggle').addEventListener('click', () => {
    const drawer = document.getElementById('cart-drawer');
    if (drawer) {
      drawer.classList.toggle('open');
    }
  });

  document.getElementById('mobile-menu-btn').addEventListener('click', () => {
    const menu = document.querySelector('.nav-menu');
    if (menu) {
      menu.classList.toggle('hidden');
      menu.style.display = menu.style.display === 'flex' ? 'none' : 'flex';
      menu.style.position = 'absolute';
      menu.style.top = '100%';
      menu.style.left = '0';
      menu.style.right = '0';
      menu.style.flexDirection = 'column';
      menu.style.gap = '0';
      menu.style.background = 'rgb(33, 30, 28)';
      menu.style.padding = '1rem';
      menu.style.zIndex = '30';
    }
  });
</script>
