<!-- Product Impression Tracking (e-commerce) -->
<script>
  // Track product impressions on product pages
  {% if product %}
    gtag('event', 'view_item', {
      'currency': 'USD',
      'value': {{ product.price | divided_by: 100.0 }},
      'items': [{
        'item_id': '{{ product.id }}',
        'item_name': '{{ product.title | escape }}',
        'item_category': '{{ product.type }}',
        'price': {{ product.price | divided_by: 100.0 }},
        'quantity': 1
      }]
    });
  {% endif %}
</script>

<!-- Add to Cart Event Tracking -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Track add-to-cart events
    const addToCartButtons = document.querySelectorAll('[data-track-add-to-cart]');
    addToCartButtons.forEach(button => {
      button.addEventListener('click', function() {
        const productData = {
          'item_name': this.dataset.productName || 'Unknown Product',
          'item_id': this.dataset.productId || '',
          'price': this.dataset.productPrice || '',
          'quantity': 1
        };

        gtag('event', 'add_to_cart', {
          'currency': 'USD',
          'value': productData.price,
          'items': [productData]
        });
      });
    });
  });
</script>

<!-- Conversion Tracking (fires on order confirmation) -->
<script>
  {% if order %}
    gtag('event', 'purchase', {
      'transaction_id': '{{ order.order_number }}',
      'affiliation': 'Dunn Luxury Selections',
      'value': {{ order.total_price | divided_by: 100.0 }},
      'currency': 'USD',
      'tax': {{ order.tax_price | divided_by: 100.0 }},
      'shipping': {{ order.shipping_price | divided_by: 100.0 }},
      'items': [
        {%- for line_item in order.line_items -%}
          {
            'item_id': '{{ line_item.product_id }}',
            'item_name': '{{ line_item.title | escape }}',
            'price': {{ line_item.price | divided_by: 100.0 }},
            'quantity': {{ line_item.quantity }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    });

    // Send conversion event to Google Ads
    gtag('event', 'conversion', {
      'send_to': 'AW-17833894840/LxbdCPIH-7QcELjH7rdC',
      'transaction_id': '{{ order.order_number }}',
      'value': {{ order.total_price | divided_by: 100.0 }},
      'currency': 'USD'
    });
  {% endif %}
</script>

<!-- Search Tracking -->
<script>
  // Track search events
  document.addEventListener('DOMContentLoaded', function() {
    const searchForm = document.querySelector('[data-track-search]');
    if (searchForm) {
      searchForm.addEventListener('submit', function(e) {
        const searchQuery = this.querySelector('input[type="search"]').value;
        gtag('event', 'search', {
          'search_term': searchQuery
        });
      });
    }
  });
</script>

