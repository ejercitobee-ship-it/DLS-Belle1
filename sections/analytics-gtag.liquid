<!-- Google Tag Manager & Analytics Configuration -->
<!-- This section should be included in theme.liquid <head> tag -->

<!-- Global Site Tag (gtag.js) - Google Ads & Analytics -->
<!-- NOTE: the base gtag snippet lives in layout/theme.liquid. Do NOT include this
     section in the layout at the same time or every tag will load twice. -->
<script async src="https://www.googletagmanager.com/gtag/js?id=GT-55VCHDDF"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}

  // Initialize Google Tag with configuration
  gtag('js', new Date());
  gtag('config', 'GT-55VCHDDF', {
    'linker': {
      'domains': ['www.dunnluxuryselections.com', 'dunnluxuryselections.com']
    },
    'send_page_view': true
  });

  // Configure Google Ads conversion tracking
  gtag('config', 'AW-17833894840', {
    'linker': {
      'domains': ['www.dunnluxuryselections.com', 'dunnluxuryselections.com']
    }
  });

  // Store cart value for conversion tracking
  window.cartValue = {{ cart.total_price | default: 0 }};
  window.cartItems = {{ cart.item_count | default: 0 }};

  // page_view is sent automatically by the gtag('config') calls above —
  // do not fire a manual page_view event here or every view double-counts.
</script>

