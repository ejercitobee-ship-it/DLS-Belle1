{% schema %}
{
  "name": "Product Gallery",
  "class": "section-product-gallery",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show Image Thumbnails",
      "default": true
    },
    {
      "type": "range",
      "id": "max_thumbnails",
      "min": 3,
      "max": 10,
      "step": 1,
      "label": "Maximum Thumbnails",
      "default": 5
    }
  ]
}
{% endschema %}

<div class="product-gallery">
  {%- if product.featured_image -%}
    <!-- Main Image -->
    <div class="gallery-main">
      <div class="main-image-wrapper">
        <img
          id="main-product-image"
          src="{{ product.featured_image | img_url: '800x800' }}"
          alt="{{ product.title }}"
          class="main-image"
          width="800"
          height="800"
        />
      </div>
    </div>

    <!-- Thumbnails -->
    {%- if product.images.size > 1 and section.settings.show_thumbnails -%}
      <div class="gallery-thumbnails">
        {%- for image in product.images limit: section.settings.max_thumbnails -%}
          <button
            class="thumbnail-item {% if forloop.first %}active{% endif %}"
            data-src="{{ image | img_url: '800x800' }}"
            data-alt="{{ product.title }}"
            type="button"
            aria-label="View image {{ forloop.index }}"
          >
            <img
              src="{{ image | img_url: '120x120' }}"
              alt="{{ product.title }} - image {{ forloop.index }}"
              width="120"
              height="120"
            />
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="gallery-placeholder">
      <p>No image available</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.product-gallery {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.gallery-main {
  width: 100%;
  background-color: var(--charcoal-900);
  border: 1px solid rgba(70, 62, 59, 0.4);
  border-radius: 0.75rem;
  overflow: hidden;
}

.main-image-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
  background-color: var(--charcoal-800);
}

.main-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.gallery-thumbnails {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  gap: 0.75rem;
}

.thumbnail-item {
  position: relative;
  aspect-ratio: 1;
  border: 2px solid transparent;
  border-radius: 0.5rem;
  overflow: hidden;
  background-color: var(--charcoal-900);
  cursor: pointer;
  transition: all 0.3s ease;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumbnail-item:hover {
  border-color: rgba(201, 138, 16, 0.5);
  transform: scale(1.05);
}

.thumbnail-item.active {
  border-color: var(--gold-500);
}

.thumbnail-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.gallery-placeholder {
  width: 100%;
  aspect-ratio: 1;
  background-color: var(--charcoal-900);
  border: 1px solid rgba(70, 62, 59, 0.4);
  border-radius: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(240, 221, 184, 0.5);
  text-align: center;
  padding: 2rem;
}
{% endstylesheet %}

{% javascript %}
(function() {
  const mainImage = document.getElementById('main-product-image');
  const thumbnails = document.querySelectorAll('.thumbnail-item');

  if (!mainImage || thumbnails.length === 0) return;

  thumbnails.forEach(thumb => {
    thumb.addEventListener('click', function(e) {
      e.preventDefault();

      // Update main image
      mainImage.src = this.dataset.src;
      mainImage.alt = this.dataset.alt;

      // Update active state
      thumbnails.forEach(t => t.classList.remove('active'));
      this.classList.add('active');
    });
  });
})();
{% endjavascript %}
