{% schema %}
{
  "name": "Featured Products",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "section_eyebrow",
      "label": "Eyebrow Text",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Latest. Acquisitions."
    },
    {
      "type": "richtext",
      "id": "section_description",
      "label": "Description",
      "default": "<p>Handpicked selections from our most exclusive collection</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Number of Products",
      "default": 3
    },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Sort By",
      "options": [
        {
          "value": "manual",
          "label": "Manual"
        },
        {
          "value": "price-desc",
          "label": "Price: High to Low"
        },
        {
          "value": "price-asc",
          "label": "Price: Low to High"
        },
        {
          "value": "created",
          "label": "Newest First"
        }
      ],
      "default": "price-desc"
    }
  ]
}
{% endschema %}

<section class="featured-products-section">
  <div class="featured-background"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative z-10">
    <!-- Section Header -->
    {%- if section.settings.section_heading != blank -%}
      <div class="section-header mb-10 md:mb-14">
        {%- if section.settings.section_eyebrow != blank -%}
          <div class="section-eyebrow mb-3">
            <div class="eyebrow-line"></div>
            <span class="eyebrow-icon">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.24l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L5 12.11 0 7.24l6.91-1.01L12 2z"/>
              </svg>
            </span>
            <span class="eyebrow-text">{{ section.settings.section_eyebrow }}</span>
          </div>
        {%- endif -%}

        <h2 class="section-title">
          {%- if section.settings.section_heading contains '.' -%}
            {%- assign parts = section.settings.section_heading | split: '.' -%}
            <span class="title-main">{{ parts[0] }}.</span>
            <span class="title-accent italic">{{ parts[1] }}</span>
          {%- else -%}
            {{ section.settings.section_heading }}
          {%- endif -%}
        </h2>

        {%- if section.settings.section_description != blank -%}
          <div class="rte section-description mt-4">
            {{ section.settings.section_description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Products Grid (Intelligent Recommendations) -->
    {%- liquid
      # Fall back to the automatic "all" collection — shop.products does not
      # exist in Liquid, and the merchant may not have picked a collection yet.
      if section.settings.collection != blank and section.settings.collection.products.size > 0
        assign products = section.settings.collection.products
      else
        assign products = collections['all'].products
      endif

      if section.settings.sort_by == 'price-desc'
        assign products = products | sort: 'price' | reverse
      elsif section.settings.sort_by == 'price-asc'
        assign products = products | sort: 'price'
      elsif section.settings.sort_by == 'created'
        assign products = products | sort: 'created_at' | reverse
      endif
    -%}

    {%- if products.size > 0 -%}
      <!-- Carousel (replicates headless NewArrivalsCarousel) -->
      <div class="fp-carousel-wrap">
        <button type="button" class="fp-arrow fp-arrow--prev" aria-label="Previous products">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <div class="fp-carousel" id="fp-carousel">
          {%- for product in products limit: 12 -%}
            <div class="fp-slide">
              {% render 'product-card', product: product, index: forloop.index, show_new_badge: true %}
            </div>
          {%- endfor -%}
        </div>
        <button type="button" class="fp-arrow fp-arrow--next" aria-label="Next products">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>

      <!-- View All CTA (replicates headless "View All New Arrivals") -->
      <div class="text-center" style="margin-top: 3rem;">
        <a href="/collections/new-arrivals" class="btn btn-primary">
          View All New Arrivals
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <p class="fp-note">Handpicked selections from our most exclusive collection</p>
      </div>

      <script>
        (function () {
          var track = document.getElementById('fp-carousel');
          if (!track) return;
          var step = function () { return track.clientWidth * 0.8; };
          document.querySelectorAll('.fp-arrow--prev').forEach(function (b) {
            b.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
          });
          document.querySelectorAll('.fp-arrow--next').forEach(function (b) {
            b.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
          });
        })();
      </script>
    {%- else -%}
      <div class="placeholder-grid">
        <div class="placeholder-card">
          <div class="placeholder-image"></div>
          <div class="placeholder-text"></div>
        </div>
        <div class="placeholder-card">
          <div class="placeholder-image"></div>
          <div class="placeholder-text"></div>
        </div>
        <div class="placeholder-card">
          <div class="placeholder-image"></div>
          <div class="placeholder-text"></div>
        </div>
      </div>
      <p class="placeholder-message">No products available. Add products to Shopify and select a collection above.</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.featured-products-section {
  position: relative;
  background-color: var(--charcoal-900);
  padding: 4rem 0;
  overflow: hidden;
}

.featured-background {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at top right, rgba(180, 140, 60, 0.06), transparent 60%);
  pointer-events: none;
}

.section-header {
  text-align: center;
}

.section-eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.eyebrow-line {
  width: 2rem;
  height: 1px;
  background-color: var(--gold-500);
}

.eyebrow-icon {
  color: var(--gold-400);
  display: inline-flex;
}

.eyebrow-text {
  color: var(--gold-400);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.4em;
  text-transform: uppercase;
}

.section-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(1.75rem, 5vw, 3.5rem);
  font-weight: 700;
  color: white;
  line-height: 1.1;
  margin: 0;
}

.title-main {
  color: white;
  font-style: normal;
}

.title-accent {
  background: linear-gradient(135deg, var(--gold-500) 0%, var(--gold-200) 50%, var(--gold-600) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-left: 0.25rem;
}

.section-description {
  color: rgba(240, 221, 184, 0.7);
  font-size: 1rem;
  line-height: 1.6;
  max-width: 40rem;
  margin-left: auto;
  margin-right: auto;
}

.section-description p {
  margin: 0;
}

.fp-carousel-wrap {
  position: relative;
}

.fp-carousel {
  display: flex;
  gap: 1.25rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  padding: 0.25rem 0.25rem 1rem;
}

.fp-carousel::-webkit-scrollbar { display: none; }

.fp-slide {
  flex: 0 0 260px;
  scroll-snap-align: start;
}

@media (min-width: 768px) {
  .fp-slide { flex-basis: 300px; }
}

.fp-arrow {
  position: absolute;
  top: 40%;
  z-index: 5;
  width: 2.75rem;
  height: 2.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999px;
  background: rgba(33, 30, 28, 0.85);
  border: 1px solid rgba(201, 138, 16, 0.35);
  color: var(--gold-300);
  cursor: pointer;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.fp-arrow:hover { color: var(--gold-200); border-color: rgba(201, 138, 16, 0.6); }
.fp-arrow--prev { left: -0.75rem; }
.fp-arrow--next { right: -0.75rem; }

.fp-note {
  color: rgba(240, 221, 184, 0.6);
  font-size: 0.8rem;
  letter-spacing: 0.03em;
  margin-top: 1rem;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  margin-top: 3rem;
}

@media (min-width: 768px) {
  .products-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
}

.product-item {
  display: flex;
  flex-direction: column;
}

/* Placeholder State */
.placeholder-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-top: 3rem;
  opacity: 0.5;
}

@media (max-width: 768px) {
  .placeholder-grid {
    grid-template-columns: 1fr;
  }
}

.placeholder-card {
  background-color: var(--charcoal-800);
  border-radius: 0.75rem;
  overflow: hidden;
  padding: 1rem;
}

.placeholder-image {
  aspect-ratio: 1;
  background-color: var(--charcoal-700);
  border-radius: 0.5rem;
  margin-bottom: 1rem;
  animation: shimmer 2s infinite;
}

.placeholder-text {
  height: 1rem;
  background-color: var(--charcoal-700);
  border-radius: 0.25rem;
  animation: shimmer 2s infinite;
}

.placeholder-message {
  text-align: center;
  color: rgba(240, 221, 184, 0.5);
  font-size: 0.9rem;
  margin-top: 2rem;
}

@keyframes shimmer {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

.rte {
  font-size: inherit;
  line-height: inherit;
}

.rte p {
  margin: 0;
}

.max-w-7xl {
  max-width: 80rem;
  margin-left: auto;
  margin-right: auto;
}

.italic {
  font-style: italic;
}
{% endstylesheet %}

