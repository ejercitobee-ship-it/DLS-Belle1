{% schema %}
{
  "name": "Featured Products",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "section_eyebrow",
      "label": "Eyebrow Text",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Latest. Acquisitions."
    },
    {
      "type": "richtext",
      "id": "section_description",
      "label": "Description",
      "default": "<p>Handpicked selections from our most exclusive collection</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Number of Products",
      "default": 3
    },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Sort By",
      "options": [
        {
          "value": "manual",
          "label": "Manual"
        },
        {
          "value": "price-desc",
          "label": "Price: High to Low"
        },
        {
          "value": "price-asc",
          "label": "Price: Low to High"
        },
        {
          "value": "created",
          "label": "Newest First"
        }
      ],
      "default": "price-desc"
    }
  ]
}
{% endschema %}

<section class="featured-products-section">
  <div class="featured-background"></div>
  <div class="featured-hairline" aria-hidden="true"></div>

  <div class="fp-container">
    <!-- Section Header (editorial: text left, controls right) -->
    {%- if section.settings.section_heading != blank -%}
      <div class="fp-head">
        <div class="fp-head-text">
          {%- if section.settings.section_eyebrow != blank -%}
            <div class="section-eyebrow">
              <span class="eyebrow-line"></span>
              <span class="eyebrow-icon">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.24l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L5 12.11 0 7.24l6.91-1.01L12 2z"/>
                </svg>
              </span>
              <span class="eyebrow-text">{{ section.settings.section_eyebrow }}</span>
            </div>
          {%- endif -%}

          <h2 class="section-title">
            {%- if section.settings.section_heading contains '.' -%}
              {%- assign parts = section.settings.section_heading | split: '.' -%}
              <span class="title-main">{{ parts[0] }}.</span>
              <span class="title-accent italic">{{ parts[1] }}</span>
            {%- else -%}
              {{ section.settings.section_heading }}
            {%- endif -%}
          </h2>

          {%- if section.settings.section_description != blank -%}
            <div class="rte section-description">
              {{ section.settings.section_description }}
            </div>
          {%- endif -%}
        </div>

        <div class="fp-controls fp-controls--top">
          <button type="button" class="fp-arrow fp-arrow--prev" aria-label="Previous products">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="fp-arrow fp-arrow--next" aria-label="Next products">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>
    {%- endif -%}

    <!-- Products (Intelligent Recommendations) -->
    {%- liquid
      # Fall back to the automatic "all" collection — shop.products does not
      # exist in Liquid, and the merchant may not have picked a collection yet.
      if section.settings.collection != blank and section.settings.collection.products.size > 0
        assign products = section.settings.collection.products
      else
        assign products = collections['all'].products
      endif

      if section.settings.sort_by == 'price-desc'
        assign products = products | sort: 'price' | reverse
      elsif section.settings.sort_by == 'price-asc'
        assign products = products | sort: 'price'
      elsif section.settings.sort_by == 'created'
        assign products = products | sort: 'created_at' | reverse
      endif
    -%}

    {%- if products.size > 0 -%}
      <!-- Carousel (replicates headless NewArrivalsCarousel) -->
      <div class="fp-carousel-wrap">
        <div class="fp-carousel" id="fp-carousel">
          {%- for product in products limit: 12 -%}
            <div class="fp-slide">
              {% render 'product-card', product: product, index: forloop.index, show_new_badge: true %}
            </div>
          {%- endfor -%}
        </div>
        <div class="fp-edge fp-edge--left" aria-hidden="true"></div>
        <div class="fp-edge fp-edge--right" aria-hidden="true"></div>
      </div>

      <!-- Progress track -->
      <div class="fp-progress" aria-hidden="true">
        <span class="fp-progress-bar" id="fp-progress-bar"></span>
      </div>

      <!-- Footer: mobile controls + View All CTA -->
      <div class="fp-foot">
        <div class="fp-controls fp-controls--bottom">
          <button type="button" class="fp-arrow fp-arrow--prev" aria-label="Previous products">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="fp-arrow fp-arrow--next" aria-label="Next products">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>

        <a href="/collections/new-arrivals" class="btn btn-primary fp-viewall">
          View All New Arrivals
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <script>
        (function () {
          var track = document.getElementById('fp-carousel');
          if (!track) return;
          var bar = document.getElementById('fp-progress-bar');
          var prev = document.querySelectorAll('.fp-arrow--prev');
          var next = document.querySelectorAll('.fp-arrow--next');
          var wrap = track.closest('.fp-carousel-wrap');
          var step = function () { return Math.max(track.clientWidth * 0.8, 240); };

          function sync() {
            var max = track.scrollWidth - track.clientWidth;
            var sl = track.scrollLeft;
            var atStart = sl <= 2;
            var atEnd = sl >= max - 2;
            prev.forEach(function (b) { b.disabled = atStart; });
            next.forEach(function (b) { b.disabled = atEnd; });
            if (wrap) {
              wrap.classList.toggle('is-start', atStart);
              wrap.classList.toggle('is-end', atEnd || max <= 0);
            }
            if (bar) {
              var frac = track.scrollWidth ? track.clientWidth / track.scrollWidth : 1;
              var ratio = max > 0 ? sl / max : 0;
              bar.style.width = Math.min(frac * 100, 100) + '%';
              bar.style.left = (ratio * (1 - frac) * 100) + '%';
            }
          }

          prev.forEach(function (b) {
            b.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
          });
          next.forEach(function (b) {
            b.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
          });
          track.addEventListener('scroll', sync, { passive: true });
          window.addEventListener('resize', sync);
          window.addEventListener('load', sync);
          sync();
        })();
      </script>
    {%- else -%}
      <div class="placeholder-grid">
        <div class="placeholder-card">
          <div class="placeholder-image"></div>
          <div class="placeholder-text"></div>
        </div>
        <div class="placeholder-card">
          <div class="placeholder-image"></div>
          <div class="placeholder-text"></div>
        </div>
        <div class="placeholder-card">
          <div class="placeholder-image"></div>
          <div class="placeholder-text"></div>
        </div>
      </div>
      <p class="placeholder-message">No products available. Add products to Shopify and select a collection above.</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.featured-products-section {
  position: relative;
  background-color: var(--charcoal-900);
  padding: 4rem 0;
  overflow: hidden;
}

.featured-background {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at top right, rgba(180, 140, 60, 0.06), transparent 60%);
  pointer-events: none;
}

.featured-hairline {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(80rem, calc(100% - 3rem));
  height: 1px;
  background: linear-gradient(to right, transparent, rgba(201, 138, 16, 0.4), transparent);
}

.fp-container {
  position: relative;
  z-index: 10;
  max-width: 80rem;
  margin: 0 auto;
  padding: 4.5rem 1.5rem 5rem;
}

@media (min-width: 768px) {
  .fp-container { padding: 6rem 2rem 6.5rem; }
}

/* ── Editorial header ── */
.fp-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 3rem;
}

.fp-head-text { max-width: 44rem; }

.section-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 1rem;
}

.eyebrow-line {
  width: 2.25rem;
  height: 1px;
  background-color: var(--gold-500);
}

.eyebrow-icon {
  color: var(--gold-400);
  display: inline-flex;
}

.eyebrow-text {
  color: var(--gold-400);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.4em;
  text-transform: uppercase;
}

.section-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  color: white;
  line-height: 1.08;
  letter-spacing: -0.01em;
  margin: 0;
}

.title-main {
  color: white;
  font-style: normal;
}

.title-accent {
  background: linear-gradient(135deg, var(--gold-500) 0%, var(--gold-200) 50%, var(--gold-600) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-left: 0.35rem;
}

.section-description {
  color: rgba(240, 221, 184, 0.65);
  font-size: 1rem;
  line-height: 1.6;
  margin-top: 1rem;
  max-width: 34rem;
}

.section-description p { margin: 0; }

/* ── Premium arrow controls ── */
.fp-controls { display: flex; gap: 0.75rem; flex-shrink: 0; }
.fp-controls--top { display: none; padding-bottom: 0.4rem; }
@media (min-width: 900px) { .fp-controls--top { display: flex; } }

.fp-arrow {
  width: 3.25rem;
  height: 3.25rem;
  border-radius: 9999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, rgba(61, 54, 52, 0.7), rgba(28, 25, 23, 0.45));
  border: 1px solid rgba(201, 138, 16, 0.4);
  color: var(--gold-300);
  cursor: pointer;
  transition: transform .3s ease, background .3s ease, border-color .3s ease, color .3s ease, box-shadow .3s ease, opacity .3s ease;
}

.fp-arrow svg { transition: transform .3s ease; }

.fp-arrow:hover:not(:disabled) {
  background: linear-gradient(135deg, var(--gold-500) 0%, var(--gold-600) 50%, var(--gold-700) 100%);
  border-color: transparent;
  color: var(--charcoal-950);
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(201, 138, 16, 0.3);
}
.fp-arrow--prev:hover:not(:disabled) svg { transform: translateX(-2px); }
.fp-arrow--next:hover:not(:disabled) svg { transform: translateX(2px); }
.fp-arrow:active:not(:disabled) { transform: scale(0.96); }
.fp-arrow:disabled { opacity: 0.28; cursor: default; }

/* ── Carousel ── */
.fp-carousel-wrap { position: relative; }

.fp-carousel {
  display: flex;
  gap: 1.5rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  padding: 0.5rem 0.25rem 1.25rem;
}

.fp-carousel::-webkit-scrollbar { display: none; }

.fp-slide {
  flex: 0 0 78%;
  max-width: 320px;
  scroll-snap-align: start;
}

@media (min-width: 640px) { .fp-slide { flex-basis: 300px; } }
@media (min-width: 768px) { .fp-slide { flex-basis: 320px; } }

/* Fade edges to hint more content */
.fp-edge {
  position: absolute;
  top: 0;
  bottom: 1.25rem;
  width: 4rem;
  pointer-events: none;
  z-index: 3;
  transition: opacity .3s ease;
}
.fp-edge--left { left: 0; background: linear-gradient(to right, var(--charcoal-900), transparent); }
.fp-edge--right { right: 0; background: linear-gradient(to left, var(--charcoal-900), transparent); }
.fp-carousel-wrap.is-start .fp-edge--left { opacity: 0; }
.fp-carousel-wrap.is-end .fp-edge--right { opacity: 0; }
@media (max-width: 640px) { .fp-edge { width: 2rem; } }

/* ── Progress track ── */
.fp-progress {
  position: relative;
  height: 2px;
  border-radius: 2px;
  background: rgba(201, 138, 16, 0.15);
  margin: 0.5rem 0.25rem 0;
  max-width: 22rem;
  overflow: hidden;
}

.fp-progress-bar {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 25%;
  border-radius: 2px;
  background: linear-gradient(to right, var(--gold-600), var(--gold-300));
  transition: left .2s ease, width .2s ease;
}

/* ── Footer (mobile controls + View All) ── */
.fp-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  margin-top: 2.75rem;
  flex-wrap: wrap;
}
.fp-controls--bottom { display: flex; }
@media (min-width: 900px) {
  .fp-controls--bottom { display: none; }
  .fp-foot { justify-content: center; }
}
@media (max-width: 640px) {
  .fp-foot { flex-direction: column; }
  .fp-viewall { width: 100%; }
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  margin-top: 3rem;
}

@media (min-width: 768px) {
  .products-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
}

.product-item {
  display: flex;
  flex-direction: column;
}

/* Placeholder State */
.placeholder-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-top: 3rem;
  opacity: 0.5;
}

@media (max-width: 768px) {
  .placeholder-grid {
    grid-template-columns: 1fr;
  }
}

.placeholder-card {
  background-color: var(--charcoal-800);
  border-radius: 0.75rem;
  overflow: hidden;
  padding: 1rem;
}

.placeholder-image {
  aspect-ratio: 1;
  background-color: var(--charcoal-700);
  border-radius: 0.5rem;
  margin-bottom: 1rem;
  animation: shimmer 2s infinite;
}

.placeholder-text {
  height: 1rem;
  background-color: var(--charcoal-700);
  border-radius: 0.25rem;
  animation: shimmer 2s infinite;
}

.placeholder-message {
  text-align: center;
  color: rgba(240, 221, 184, 0.5);
  font-size: 0.9rem;
  margin-top: 2rem;
}

@keyframes shimmer {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

.rte {
  font-size: inherit;
  line-height: inherit;
}

.rte p {
  margin: 0;
}

.max-w-7xl {
  max-width: 80rem;
  margin-left: auto;
  margin-right: auto;
}

.italic {
  font-style: italic;
}
{% endstylesheet %}

