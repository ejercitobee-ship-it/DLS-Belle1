<!-- Hero Section -->
<section class="hero" style="{% if page.template == 'index' %}background-image: linear-gradient(135deg, rgba(33, 30, 28, 0.6) 0%, rgba(61, 54, 52, 0.6) 100%), url('https://images.unsplash.com/photo-1578500494198-246f612d782b?w=1200&h=600&fit=crop&crop=center'); background-size: cover; background-position: center;{% endif %}">
  <div class="hero-content">
    <h1>The World's Finest Humidor Collections</h1>
    <p>Precision climate-controlled storage for your most prized cigars</p>
    <a href="/collections/all" class="hero-cta">Explore Premium Collections</a>
  </div>
</section>

<!-- Featured Products Section -->
{% section 'featured-collection' %}

<!-- Financing Banner -->
<section class="financing-banner section-spacing">
  <div class="financing-container">
    <h2>Remove Barriers to Building Your <span class="text-gold-400">Collection</span></h2>
    <p>
      Pay for premium humidors over time with Shop Pay Installments.
      Qualify for 0% APR on purchases over $1,500.
    </p>

    <div class="financing-highlights">
      <div class="highlight">
        <svg class="highlight-icon" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8m.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" />
        </svg>
        <h4 class="font-semibold text-white mb-2">4 Easy Payments</h4>
        <p class="text-cream-200-70 text-sm">Pay over 6 weeks with no interest</p>
