<!-- Newsletter -->
<section class="bg-charcoal-950 border-t border-charcoal-800-40 section-spacing">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-serif text-3xl font-700 text-white mb-4">
      Stay Updated
    </h2>
    <p class="text-cream-200-70 mb-8">
      Get expert tips, new arrivals, and exclusive offers delivered to your inbox.
    </p>

    <form method="post" action="/contact#newsletter" class="flex flex-col sm:flex-row gap-4">
      <input
        type="email"
        name="contact[email]"
        placeholder="Enter your email"
        required
        class="flex-1 px-4 py-3 bg-charcoal-900 border border-charcoal-800-60 text-white rounded placeholder-cream-200-40 focus:outline-none focus:border-gold-500-60"
      />
      <button
        type="submit"
        class="px-6 py-3 bg-gold-500 text-charcoal-950 font-semibold rounded hover:bg-gold-400 transition-all active:scale-95"
      >
        Subscribe
      </button>
    </form>

    <p class="text-cream-200-40 text-xs mt-4">
      We respect your privacy. Unsubscribe at any time.
    </p>
  </div>
</section>
