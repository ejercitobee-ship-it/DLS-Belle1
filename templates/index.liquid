<!-- Collections Section -->
<section class="section-spacing">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="section-header">
      <h2>Browse by Category</h2>
    </div>

    <div class="collections-grid">
    {% assign categories = "Electronic Humidors|Cabinet Humidors|Desktop Humidors|Travel Humidors" | split: "|" %}
    {% assign handles = "electronic-humidors|cabinet-humidors|desktop-humidors|travel-humidors" | split: "|" %}

    {% for i in (0..3) %}
      <a href="/collections/{{ handles[i] }}" class="collection-card">
        {% assign col = collections[handles[i]] %}
        {% if col.featured_image %}
          <img src="{{ col.featured_image | img_url: '600x400' }}" alt="{{ categories[i] }}" class="collection-image" />
        {% else %}
          <div class="collection-image bg-charcoal-800"></div>
        {% endif %}
        <div class="collection-overlay">
          <h3 class="collection-name">{{ categories[i] }}</h3>
        </div>
      </a>
    {% endfor %}
    </div>
  </div>
</section>

