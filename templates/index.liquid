<!-- Hero Section -->
<section class="hero">
  <div class="hero-content">
    <h1>Luxury Humidors for Connoisseurs</h1>
    <p>Precision climate-controlled storage for your finest cigars</p>
    <a href="/collections/all" class="hero-cta">Shop Collection</a>
  </div>
</section>

<!-- Featured Products Section -->
<section class="section-spacing">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="section-header">
      <h2>Featured Collection</h2>
      <p class="text-lg mb-12">
        Discover our handpicked selection of premium humidors
      </p>
    </div>

    <div class="featured-grid">
      {% for product in collections.all.products limit: 3 %}
        <a href="{{ product.url }}" class="featured-card">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '400x300' }}" alt="{{ product.title }}" class="featured-image" />
          {% else %}
            <div class="featured-image bg-charcoal-800"></div>
          {% endif %}

          <div class="featured-content">
            <h3 class="featured-title">{{ product.title }}</h3>
            <div class="featured-price">
              {% if product.price_min == product.price_max %}
                {{ product.price_min | money }}
              {% else %}
                {{ product.price_min | money }} - {{ product.price_max | money }}
              {% endif %}
            </div>
            <p class="featured-desc">
              {{ product.description | strip_html | truncatewords: 15 }}
            </p>
            <span class="featured-cta">View Details →</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

