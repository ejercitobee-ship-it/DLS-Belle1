      <div class="highlight">
        <svg class="highlight-icon" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 1c-6.338 0-12 4.226-12 10.007 0 2.05.738 4.063 2.047 5.625.055 3.215 1.308 4.921 2.91 6.368-1.2-.75-2.147-2.016-2.577-3.516 1.926 1.265 4.16 2.195 6.62 2.195 6.338 0 12-4.226 12-10.007C24 5.226 18.338 1 12 1zm0 18c-4.968 0-9-2.686-9-6s4.032-6 9-6 9 2.686 9 6-4.032 6-9 6z" />
