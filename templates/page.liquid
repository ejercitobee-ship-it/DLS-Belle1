<!-- Page Hero -->
<section class="page-hero">
  <div class="page-hero-content">
    <h1>{{ page.title }}</h1>
  </div>
</section>

<!-- Page Content -->
<div class="page-container">
  <a href="/" class="back-link">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Home
  </a>

  <div class="page-content">
    {{ page.content }}
  </div>

  <!-- Financing-Specific CTA -->
  {% if page.handle == 'financing' %}
    <div class="mt-12 text-center">
      <h3 class="font-serif text-2xl font-700 text-white mb-4">Ready to Finance Your Humidor?</h3>
      <p class="text-cream-200/70 mb-6">
        Browse our collection of premium humidors eligible for Shop Pay Installments.
      </p>
      <a href="/collections/all" class="financing-cta">
        Shop Now
      </a>
    </div>
  {% endif %}

