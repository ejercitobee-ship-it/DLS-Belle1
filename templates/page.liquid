    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: white;
    line-height: 1.1;
    margin: 0 0 0.5rem 0;
  }

  .page-date {
    color: rgba(240, 221, 184, 0.5);
    font-size: 0.85rem;
  }

  .page-body {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(240, 221, 184, 0.8);
    max-width: 48rem;
    margin: 0 auto 3rem;
  }

  .page-body h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .page-body h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .page-body p {
    margin-bottom: 1.25rem;
  }

  .page-body ul,
  .page-body ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .page-body li {
    margin-bottom: 0.5rem;
  }

  .page-body a {
    color: var(--gold-400);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .page-body a:hover {
