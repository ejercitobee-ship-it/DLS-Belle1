{%- comment -%}
The one-pager is a full standalone landing document (its own <head>/<body>),
so it renders with no theme chrome via a conditional layout. Everything else
falls through to the normal page rendering below.
{%- endcomment -%}
{%- if page.handle == 'onepager' -%}
  {%- layout none -%}
  {%- render 'onepager-doc' -%}
{%- else -%}
{%- comment -%}
Pages ported from the headless storefront render fully-designed baked content
(snippets/page-content-<handle>.liquid) so they match dunnluxuryselections.com
exactly. Admin page body is ignored for these handles — remove a handle from
this list to hand control back to the Shopify page editor.
{%- endcomment -%}
{%- assign baked_handles = 'about-us,financing,care-guides,delivery-info,returns-warranty,privacy-policy,terms-of-service,cookie-policy,walk-in-humidor,contact' | split: ',' -%}

{%- if baked_handles contains page.handle -%}
  {%- case page.handle -%}
    {%- when 'about-us' -%}{% render 'page-content-about-us' %}
    {%- when 'walk-in-humidor' -%}{% render 'page-content-walk-in-humidor' %}
    {%- when 'financing' -%}{% render 'page-content-financing' %}
    {%- when 'care-guides' -%}{% render 'page-content-care-guides' %}
    {%- when 'delivery-info' -%}{% render 'page-content-delivery-info' %}
    {%- when 'returns-warranty' -%}{% render 'page-content-returns-warranty' %}
    {%- when 'privacy-policy' -%}{% render 'page-content-privacy-policy' %}
    {%- when 'terms-of-service' -%}{% render 'page-content-terms-of-service' %}
    {%- when 'cookie-policy' -%}{% render 'page-content-cookie-policy' %}
    {%- when 'contact' -%}{% render 'page-content-contact' %}
  {%- endcase -%}

  {% section 'newsletter' %}
{%- else -%}
<!-- Page Content -->
<div class="page-wrapper">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <!-- Page Header -->
    <header class="page-header mb-12">
      <h1 class="page-title">{{ page.title }}</h1>
      {%- if page.published_at -%}
        <time class="page-date" datetime="{{ page.published_at | date: '%Y-%m-%d' }}">
          Updated {{ page.published_at | date: '%B %d, %Y' }}
        </time>
      {%- endif -%}
    </header>

    <!-- Page Body -->
    <div class="page-body">
      {{ page.content }}
    </div>

    <!-- Financing-Specific CTA -->
    {% if page.handle == 'financing' %}
      <div class="financing-cta-section">
        <h3 class="financing-cta-title">Ready to Finance Your Humidor?</h3>
        <p class="financing-cta-text">Browse our collection of premium humidors eligible for Shop Pay Installments.</p>
        <a href="/collections/all" class="btn-financing">Shop Now</a>
      </div>
    {% endif %}

    <!-- Related Pages Navigation -->
    {%- if page.handle == 'financing' -%}
      <nav class="related-pages">
        <h3 class="related-title">Related Information</h3>
        <ul class="related-list">
          <li><a href="/pages/delivery-info">Shipping & Delivery</a></li>
          <li><a href="/pages/returns-warranty">Returns & Warranty</a></li>
          <li><a href="/pages/care-guides">Care Guides</a></li>
        </ul>
      </nav>
    {%- elsif page.handle == 'about-us' -%}
      <nav class="related-pages">
        <h3 class="related-title">Learn More</h3>
        <ul class="related-list">
          <li><a href="/pages/care-guides">Care Guides</a></li>
          <li><a href="/pages/financing">Financing Options</a></li>
          <li><a href="/collections/all">Browse Collections</a></li>
        </ul>
      </nav>
    {%- endif -%}
  </div>
</div>

<!-- Newsletter Section -->
{% section 'newsletter' %}
{%- endif -%}

<style>
