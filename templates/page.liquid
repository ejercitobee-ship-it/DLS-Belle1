    font-style: italic;
    color: rgba(240, 221, 184, 0.9);
  }

  .page-body blockquote {
    border-left: 4px solid var(--gold-500);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: rgba(240, 221, 184, 0.7);
  }

  .financing-cta-section {
    text-align: center;
    margin: 3rem 0;
    padding: 2rem;
    background-color: rgba(201, 138, 16, 0.08);
    border: 1px solid rgba(201, 138, 16, 0.2);
    border-radius: 0.75rem;
  }

  .financing-cta-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin-bottom: 0.75rem;
  }

  .financing-cta-text {
    color: rgba(240, 221, 184, 0.8);
    margin-bottom: 1.5rem;
  }

  .btn-financing {
