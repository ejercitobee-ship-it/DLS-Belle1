<!-- Reset Password -->
<div class="page-wrapper">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <header class="page-header" style="margin-bottom: 2.5rem; text-align: center;">
      <h1 class="page-title">Reset Your Password</h1>
      <p style="opacity: 0.8; margin-top: 0.75rem;">Enter a new password for {{ email }}.</p>
    </header>

    <div class="account-form-card">
      {% form 'reset_customer_password' %}
        {%- if form.errors -%}
          <div class="form-errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <label for="ResetPassword">New Password</label>
        <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required />

        <label for="ResetPasswordConfirm">Confirm New Password</label>
        <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required />

        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1.25rem;">Reset Password</button>
      {% endform %}
    </div>
  </div>
</div>

<style>
  .account-form-card {
    max-width: 440px;
    margin: 0 auto;
    padding: 2rem;
    background: var(--charcoal-900);
    border: 1px solid rgba(201, 138, 16, 0.2);
    border-radius: 8px;
  }
  .account-form-card label { display: block; margin: 1rem 0 0.35rem; font-size: 0.9rem; }
  .account-form-card input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--charcoal-950);
    border: 1px solid rgba(201, 138, 16, 0.3);
    border-radius: 4px;
    color: var(--cream-100);
  }
  .form-errors { color: #e57373; margin-bottom: 1rem; font-size: 0.9rem; }
</style>
