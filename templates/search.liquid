<!-- Search Results -->
<div class="srch">
  <div class="srch-container">
    <header class="srch-header">
      <div class="srch-eyebrow">Search</div>
      <h1 class="srch-title">
        {%- if search.performed -%}
          Search <span class="text-gradient-gold">Results</span>
        {%- else -%}
          Search the <span class="text-gradient-gold">Collection</span>
        {%- endif -%}
      </h1>
      {%- if search.performed -%}
        <p class="srch-count">
          {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms | escape }}&rdquo;
        </p>
      {%- endif -%}
    </header>

    <form action="{{ routes.search_url }}" method="get" role="search" data-search-form class="srch-form">
      <div class="srch-field">
        <svg class="srch-field__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search humidors, accessories, guides..."
          aria-label="Search"
          class="srch-input"
        />
      </div>
      <button type="submit" class="srch-btn">Search</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        {%- paginate search.results by 24 -%}
          <div class="srch-grid">
            {%- for item in search.results -%}
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'product-card', product: item, index: forloop.index %}
                {%- when 'article' -%}
                  <a href="{{ item.url }}" class="srch-card">
                    {%- if item.image -%}
                      <span class="srch-card__media">
                        <img src="{{ item.image | image_url: width: 480 }}" alt="{{ item.image.alt | default: item.title | escape }}" loading="lazy" width="480" height="270" />
                      </span>
                    {%- endif -%}
                    <span class="srch-card__body">
                      <span class="srch-card__pill">Journal</span>
                      <span class="srch-card__title">{{ item.title }}</span>
                      <span class="srch-card__excerpt">{{ item.excerpt_or_content | strip_html | truncatewords: 20 }}</span>
                    </span>
                  </a>
                {%- when 'page' -%}
                  <a href="{{ item.url }}" class="srch-card">
                    <span class="srch-card__body">
                      <span class="srch-card__pill">Page</span>
                      <span class="srch-card__title">{{ item.title }}</span>
                      <span class="srch-card__excerpt">{{ item.content | strip_html | truncatewords: 20 }}</span>
                    </span>
                  </a>
              {%- endcase -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="srch-pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="btn btn-secondary">Previous</a>
              {%- endif -%}
              <span class="srch-pagination__label">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="btn btn-secondary">Next</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="srch-empty">
          <p>No results found for &ldquo;{{ search.terms | escape }}&rdquo;.</p>
          <a href="/collections/all" class="btn btn-primary">Browse All Humidors</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<style>
  .srch { background: var(--charcoal-950); padding: 3.5rem 0 5rem; }
  .srch-container { max-width: 80rem; margin: 0 auto; padding: 0 1.5rem; }

  .srch-header { margin-bottom: 2rem; }
  .srch-eyebrow {
    display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;
    color: var(--gold-400); font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.4em; text-transform: uppercase;
  }
  .srch-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--gold-500); }
  .srch-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; color: white;
    line-height: 1.1; margin: 0;
  }
  .srch-count { color: rgba(240, 221, 184, 0.6); margin: 0.75rem 0 0; font-size: 0.95rem; }

  /* Search form — input grows, button stays content-sized. The explicit
     width:auto overrides the global `input { width: 100% }` rule that would
     otherwise collapse the flex layout. */
  .srch-form {
    display: flex;
    gap: 0.75rem;
    max-width: 640px;
    margin-bottom: 3rem;
  }
  .srch-field {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--charcoal-900);
    border: 1px solid rgba(201, 138, 16, 0.3);
    border-radius: 0.5rem;
    padding: 0 0.9rem;
  }
  .srch-field:focus-within { border-color: var(--gold-500); }
  .srch-field__icon { color: rgba(240, 221, 184, 0.4); flex-shrink: 0; }
  .srch-input {
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    background: transparent;
    border: none;
    padding: 0.8rem 0;
    color: var(--cream-100);
    font-size: 0.95rem;
  }
  .srch-input:focus { outline: none; box-shadow: none; background: transparent; }
  .srch-btn {
    flex: 0 0 auto;
    width: auto;
    white-space: nowrap;
    padding: 0.8rem 1.75rem;
    border: none;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, var(--gold-500) 0%, var(--gold-600) 50%, var(--gold-700) 100%);
    color: var(--charcoal-950);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .srch-btn:hover { opacity: 0.9; }

  .srch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  /* Article / page result cards, styled to match the redesigned journal cards */
  .srch-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--charcoal-900);
    border: 1px solid rgba(70, 62, 59, 0.5);
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .srch-card:hover { border-color: rgba(164, 108, 12, 0.4); transform: translateY(-3px); }
  .srch-card__media { display: block; aspect-ratio: 16 / 9; background: var(--charcoal-800); overflow: hidden; }
  .srch-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .srch-card__body { display: flex; flex-direction: column; flex: 1; padding: 1.25rem; }
  .srch-card__pill {
    align-self: flex-start;
    background: rgba(201, 138, 16, 0.15);
    border: 1px solid rgba(201, 138, 16, 0.3);
    color: var(--gold-400);
    font-size: 10px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase;
    padding: 0.3rem 0.65rem; border-radius: 9999px; margin-bottom: 0.75rem;
  }
  .srch-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    color: white; font-size: 1.05rem; font-weight: 700; line-height: 1.35;
    margin-bottom: 0.5rem;
  }
  .srch-card:hover .srch-card__title { color: var(--gold-200); }
  .srch-card__excerpt {
    color: rgba(240, 221, 184, 0.5); font-size: 0.85rem; line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  .srch-pagination { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 3rem; }
  .srch-pagination__label { color: rgba(240, 221, 184, 0.4); font-size: 0.8rem; }

  .srch-empty { text-align: center; padding: 4rem 1rem; }
  .srch-empty p { color: rgba(240, 221, 184, 0.6); margin-bottom: 1.5rem; }

  /* Stack the form on small phones so the button never crowds the input */
  @media (max-width: 520px) {
    .srch-form { flex-direction: column; }
    .srch-btn { width: 100%; }
  }
</style>
