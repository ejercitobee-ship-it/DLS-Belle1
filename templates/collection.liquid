{%- comment -%}
Collection page — replicates the headless category pages (DesktopHumidors.tsx
et al.): breadcrumb, image hero with gradient + two-tone serif title + phone,
compact financing banner, "Available Models" toolbar with count + sort,
4-column product grid, Explore More Collections links.
{%- endcomment -%}

{%- liquid
  assign title_words = collection.title | split: ' '
  assign last_word = title_words | last
  assign first_words = collection.title | remove_last: last_word | strip
-%}

<!-- Breadcrumb -->
<div class="clp-container" style="padding-top: 1.5rem; padding-bottom: 1rem;">
  <nav class="clp-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="{{ routes.collections_url }}">Collections</a>
    <span>/</span>
    <span class="clp-breadcrumb__current">{{ collection.title }}</span>
  </nav>
</div>

<!-- Hero banner -->
<div class="clp-hero">
  {%- if collection.image -%}
    <img src="{{ collection.image | image_url: width: 1800 }}" alt="{{ collection.title | escape }}" loading="lazy" width="1800" height="500" class="clp-hero__img" />
  {%- endif -%}
  <div class="clp-hero__overlay"></div>
  <div class="clp-container clp-hero__content">
    <div class="clp-eyebrow">Collection</div>
    <h1 class="clp-title">
      {%- if first_words != blank -%}
        {{ first_words }} <span class="text-gradient-gold">{{ last_word }}</span>
      {%- else -%}
        {{ collection.title }}
      {%- endif -%}
    </h1>
    {%- if collection.description != blank -%}
      <p class="clp-desc">{{ collection.description | strip_html | truncate: 180 }}</p>
    {%- endif -%}
    <a href="tel:8884319214" class="clp-phone">&#9742; (888) 431-9214</a>
  </div>
</div>

<!-- Financing Banner (compact) -->
{% section 'financing-banner-compact' %}

<!-- Products -->
<div class="clp-container" style="padding-top: 2.5rem; padding-bottom: 4rem;">
  <h2 class="clp-h2">Available Models</h2>

  {%- paginate collection.products by 24 -%}
    <!-- Toolbar -->
    <div class="clp-toolbar">
      <p class="clp-count"><span>{{ collection.products_count }}</span> products</p>
      <form method="get" class="clp-sort">
        <label for="clp-sort-select">Sort by</label>
        <select id="clp-sort-select" name="sort_by" onchange="this.form.submit()" data-sort>
          {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
          <option value="manual" {% if current_sort == 'manual' %}selected{% endif %}>Featured</option>
          <option value="best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>Best Selling</option>
          <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
          <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
          <option value="created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>Newest</option>
          <option value="title-ascending" {% if current_sort == 'title-ascending' %}selected{% endif %}>A&ndash;Z</option>
        </select>
      </form>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="clp-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, index: forloop.index %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="clp-pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn-secondary">Previous</a>{%- endif -%}
          <span class="clp-pagination__label">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn-secondary">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="clp-empty">
        <p>No products found in this collection yet.</p>
        <a href="/collections/all" class="btn btn-primary">Browse All Products</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}

  <!-- Explore More Collections -->
  <section class="clp-explore">
    <h2 class="clp-h2" style="font-size: 1.5rem;">Explore More Collections</h2>
    <div class="clp-explore__grid">
      {%- for other in collections -%}
        {%- unless other.handle == collection.handle or other.handle == 'frontpage' or other.products_count == 0 -%}
          <a href="{{ other.url }}" class="clp-explore__link">
            {{ other.title | split: '–' | first | split: '|' | first | strip }}
            <span>{{ other.products_count }} products &rarr;</span>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>
</div>

<!-- Testimonials + Newsletter -->
{% section 'testimonials' %}
{% section 'newsletter' %}

{% stylesheet %}
.clp-container { max-width: 80rem; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem; }
.clp-breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; }
.clp-breadcrumb a { color: var(--gold-400); text-decoration: none; }
.clp-breadcrumb a:hover { color: var(--gold-300); }
.clp-breadcrumb span { color: rgba(240, 221, 184, 0.4); }
.clp-breadcrumb__current { color: white !important; }

.clp-hero { position: relative; min-height: 16rem; display: flex; align-items: center; overflow: hidden; background: var(--charcoal-900); }
.clp-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.clp-hero__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(33, 30, 28, 0.9), rgba(33, 30, 28, 0.6) 50%, rgba(33, 30, 28, 0.3)); }
.clp-hero__content { position: relative; z-index: 1; width: 100%; padding-top: 3rem; padding-bottom: 3rem; }
.clp-eyebrow { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; color: var(--gold-400); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.4em; text-transform: uppercase; }
.clp-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--gold-500); }
.clp-title { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(2.25rem, 6vw, 3.75rem); font-weight: 700; color: white; margin: 0; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5); }
.clp-desc { color: rgba(240, 221, 184, 0.6); max-width: 32rem; margin: 0.5rem 0 0; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6); }
.clp-phone { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1rem; color: var(--gold-400); font-size: 0.875rem; font-weight: 500; text-decoration: none; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9); }
.clp-phone:hover { color: var(--gold-300); }

.clp-h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.875rem; font-weight: 700; color: white; margin: 0 0 2rem; }

.clp-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(70, 62, 59, 0.5); }
.clp-count { color: rgba(240, 221, 184, 0.4); font-size: 0.875rem; margin: 0; }
.clp-count span { color: white; font-weight: 500; }
.clp-sort { display: flex; align-items: center; gap: 0.5rem; }
.clp-sort label { color: rgba(240, 221, 184, 0.4); font-size: 0.8rem; }
.clp-sort select { background: var(--charcoal-900); border: 1px solid rgba(83, 72, 68, 0.6); color: white; font-size: 0.8rem; padding: 0.45rem 0.75rem; border-radius: 0.25rem; }

.clp-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
@media (min-width: 640px) { .clp-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .clp-grid { grid-template-columns: repeat(3, 1fr); } }
@media (min-width: 1280px) { .clp-grid { grid-template-columns: repeat(4, 1fr); } }

.clp-pagination { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 3rem; }
.clp-pagination__label { color: rgba(240, 221, 184, 0.4); font-size: 0.8rem; }

.clp-empty { text-align: center; padding: 4rem 1rem; }
.clp-empty p { color: rgba(240, 221, 184, 0.5); margin-bottom: 1.5rem; }

.clp-explore { margin-top: 5rem; padding-top: 3rem; border-top: 1px solid rgba(70, 62, 59, 0.4); }
.clp-explore__grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
@media (min-width: 640px) { .clp-explore__grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .clp-explore__grid { grid-template-columns: repeat(3, 1fr); } }
.clp-explore__link { display: flex; align-items: center; justify-content: space-between; gap: 1rem; background: var(--charcoal-900); border: 1px solid rgba(70, 62, 59, 0.5); border-radius: 0.5rem; padding: 1rem 1.25rem; color: var(--cream-100); font-size: 0.9rem; font-weight: 500; text-decoration: none; transition: border-color 0.2s ease; }
.clp-explore__link:hover { border-color: rgba(201, 138, 16, 0.4); }
.clp-explore__link span { color: var(--gold-400); font-size: 0.75rem; white-space: nowrap; }
{% endstylesheet %}
