{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ shop.name }} — Gift Card</title>
  <meta name="robots" content="noindex" />
  {{ 'main.css' | asset_url | stylesheet_tag }}
  <style>
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    .gift-card-wrapper { max-width: 480px; padding: 2.5rem; text-align: center; background: var(--charcoal-900); border: 1px solid rgba(201, 138, 16, 0.3); border-radius: 12px; }
    .gift-card-code { font-size: 1.5rem; letter-spacing: 0.15em; padding: 1rem; margin: 1.5rem 0; background: var(--charcoal-950); border: 1px dashed rgba(201, 138, 16, 0.5); border-radius: 6px; }
    .gift-card-amount { font-size: 2.5rem; font-weight: 700; }
  </style>
</head>
<body class="bg-charcoal-950 text-cream-100">
  <div class="gift-card-wrapper">
    <h1>{{ shop.name }}</h1>
    <p>Your gift card</p>
    <p class="gift-card-amount text-gold">{{ gift_card.initial_value | money }}</p>
    {%- if gift_card.enabled == false or gift_card.expired -%}
      <p>This gift card has expired.</p>
    {%- else -%}
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p>Remaining balance: {{ gift_card.balance | money }}</p>
      {%- endif -%}
      <div class="gift-card-code">{{ gift_card.code | format_code }}</div>
      <p>Use this code at checkout to redeem your gift card.</p>
    {%- endif -%}
    <a href="{{ shop.url }}" class="btn btn-primary" style="margin-top: 1rem;">Start Shopping</a>
  </div>
</body>
</html>
