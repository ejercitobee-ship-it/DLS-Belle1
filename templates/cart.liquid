<!-- Shopping Cart Page -->

<div class="cart-page">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <h1 class="page-title">Shopping Cart</h1>

    {%- if cart.item_count > 0 -%}
      <div class="cart-layout">
        <!-- Left: Cart Items -->
        <div class="cart-items-wrapper">
          {% section 'cart-items' %}
        </div>

        <!-- Right: Order Summary -->
        <div class="cart-summary-wrapper">
          {% section 'order-summary' %}
        </div>
      </div>
    {%- else -%}
      <div class="cart-empty">
        <div class="empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </div>
        <h2>Your cart is empty</h2>
        <p>Browse our collections and add some items to get started.</p>
        <a href="/collections/all" class="btn btn-primary">Continue Shopping</a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .cart-page {
    background-color: var(--charcoal-950);
    min-height: 80vh;
  }

  .page-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: white;
    margin-bottom: 2rem;
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .cart-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .cart-items-wrapper {
    display: flex;
    flex-direction: column;
  }

  .cart-summary-wrapper {
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 6rem;
  }

  @media (max-width: 768px) {
    .cart-summary-wrapper {
      position: static;
    }
  }

  .cart-empty {
    text-align: center;
    padding: 4rem 2rem;
    background-color: var(--charcoal-900);
    border: 1px solid rgba(70, 62, 59, 0.4);
    border-radius: 0.75rem;
  }

  .empty-icon {
    width: 6rem;
    height: 6rem;
    margin: 0 auto 1.5rem;
    padding: 1rem;
    background-color: rgba(201, 138, 16, 0.1);
    border-radius: 0.75rem;
    color: var(--gold-500);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-empty h2 {
    color: white;
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .cart-empty p {
    color: rgba(240, 221, 184, 0.7);
    margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--gold-600) 0%, var(--gold-500) 50%, var(--gold-700) 100%);
    color: var(--charcoal-950);
    box-shadow: 0 4px 12px rgba(201, 138, 16, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(201, 138, 16, 0.4);
  }

  .max-w-7xl {
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
  }

  .py-8 {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .md\:py-12 {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }
  }
</style>
  {% if cart.item_count == 0 %}
    <!-- Empty Cart -->
    <div class="cart-empty">
      <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <h1 class="empty-title">Your cart is empty</h1>
      <p class="empty-desc">
        You haven't added any luxury humidors yet. Start exploring our collections!
      </p>
      <a href="/collections" class="inline-block px-6 py-3 bg-gold-500 text-charcoal-950 font-semibold rounded hover:bg-gold-400 transition-all">
        Continue Shopping
      </a>
    </div>
  {% else %}
    <!-- Cart Content -->
    <div class="cart-header">
      <h1>Your Cart</h1>
      <a href="/collections" class="continue-shopping">Continue Shopping →</a>
    </div>

    <div class="cart-content">
      <!-- Items -->
      <div class="cart-items">
        <form method="post" action="/cart" id="cart-form">
          {% for item in cart.items %}
            <div class="cart-item">
              {% if item.image %}
                <a href="{{ item.product.url }}" class="item-image">
                  <img src="{{ item.image | img_url: '100x100' }}" alt="{{ item.title }}" />
                </a>
              {% endif %}

              <div class="item-details">
                <a href="{{ item.product.url }}" class="item-title">{{ item.product.title }}</a>

                {% if item.variant.title != "Default Title" %}
                  <div class="item-variant">{{ item.variant.title }}</div>
                {% endif %}

                <div class="item-price">{{ item.price | money }}</div>

                <div class="item-actions">
                  <div class="qty-selector">
                    <button
                      type="button"
                      class="qty-btn"
                      onclick="updateQuantity('{{ item.key }}', Math.max(1, parseInt(document.querySelector('[data-quantity-{{ item.key }}]').value) - 1))"
                    >
                      −
                    </button>
                    <input
                      type="number"
                      name="updates[{{ item.key }}]"
                      value="{{ item.quantity }}"
                      min="1"
                      class="qty-input"
                      data-quantity-{{ item.key }}
                      onchange="updateQuantity('{{ item.key }}', this.value)"
                    />
                    <button
                      type="button"
                      class="qty-btn"
                      onclick="updateQuantity('{{ item.key }}', parseInt(document.querySelector('[data-quantity-{{ item.key }}]').value) + 1)"
                    >
                      +
                    </button>
                  </div>

                  <button
                    type="button"
                    class="remove-btn"
                    onclick="removeItem('{{ item.key }}')"
                  >
                    Remove
                  </button>
                </div>
              </div>

              <div class="text-right ml-4">
                <div class="text-white font-semibold">{{ item.final_line_price | money }}</div>
                {% if item.quantity_input_disabled %}
                  <div class="text-cream-200/60 text-xs mt-1">{{ item.quantity_input_disabled }}</div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </form>
      </div>

      <!-- Summary -->
      <aside class="cart-summary">
        <div class="summary-card">
          <h2 class="summary-title">Order Summary</h2>

          <div class="summary-line">
            <span class="summary-label">Subtotal</span>
            <span class="summary-value">{{ cart.subtotal_price | money }}</span>
          </div>

          <div class="summary-line">
            <span class="summary-label">Shipping</span>
            <span class="summary-value">Calculated at checkout</span>
          </div>

          <div class="summary-line">
            <span class="summary-label">Tax</span>
            <span class="summary-value">Calculated at checkout</span>
          </div>

          <div class="summary-total">
            <span class="summary-total-label">Total</span>
            <span class="summary-total-value">{{ cart.total_price | money }}</span>
          </div>

          <form method="post" action="/checkout">
            <button type="submit" class="checkout-btn">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Proceed to Checkout
            </button>
          </form>

          <a href="/collections" class="continue-btn">
            Continue Shopping
          </a>

          <!-- Financing Note -->
          {% if cart.total_price >= 150000 %}
            <div class="financing-note">
              <strong>Shop Pay Installments Available</strong><br />
              <div class="note-content">
                Finance your purchase in 4 interest-free payments with Shop Pay. Learn more during checkout.
              </div>
            </div>
          {% endif %}

          <!-- Trust Badges -->
          <div class="mt-6 space-y-2 text-xs text-cream-200/60">
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5 text-gold-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
              </svg>
              <span>Secure Shop Pay checkout</span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5 text-gold-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 6H6.28l-.31-1.243A1 1 0 005 4H3z" />
              </svg>
              <span>Free shipping on orders $2,000+</span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5 text-gold-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>30-day money-back guarantee</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  {% endif %}
</div>

<script>
  function updateQuantity(key, quantity) {
    const form = document.getElementById('cart-form');
    const input = form.querySelector(`input[data-quantity-${key}]`);
    input.value = Math.max(1, quantity);
    form.submit();
  }

  function removeItem(key) {
    const form = document.getElementById('cart-form');
    const input = form.querySelector(`input[data-quantity-${key}]`);
    input.value = 0;
    form.submit();
  }
</script>
