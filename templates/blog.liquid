<!-- Blog / Journal Listing -->
<div class="page-wrapper">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <header class="page-header" style="margin-bottom: 3rem; text-align: center;">
      <h1 class="page-title">{{ blog.title }}</h1>
      <p style="opacity: 0.8; margin-top: 0.75rem;">Guides, insights, and craftsmanship from the world of luxury humidors.</p>
    </header>

    {%- paginate blog.articles by 12 -%}
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="journal-card">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 600 }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
                width="600"
                height="400"
                style="width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 8px 8px 0 0;"
              />
            {%- endif -%}
            <div style="padding: 1.5rem;">
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" class="text-gold" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em;">
                {{ article.published_at | date: '%B %d, %Y' }}
              </time>
              <h2 style="margin: 0.5rem 0; font-size: 1.25rem;">{{ article.title }}</h2>
              <p style="opacity: 0.7; font-size: 0.9rem;">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" style="display: flex; gap: 0.75rem; justify-content: center; margin-top: 3rem;">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn btn-secondary">Previous</a>
          {%- endif -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn btn-secondary">Next</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

<!-- Newsletter Signup -->
{% section 'newsletter' %}

<style>
  .journal-card {
    display: block;
    background: var(--charcoal-900);
    border: 1px solid rgba(201, 138, 16, 0.2);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .journal-card:hover {
    border-color: rgba(201, 138, 16, 0.5);
    transform: translateY(-2px);
  }
</style>
