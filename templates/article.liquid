<!-- Journal Article -->
<article class="page-wrapper">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <header class="page-header" style="margin-bottom: 2.5rem;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1rem; font-size: 0.875rem;">
        <a href="{{ blog.url }}" class="text-gold" style="text-decoration: none;">&larr; Back to {{ blog.title }}</a>
      </nav>
      <h1 class="page-title">{{ article.title }}</h1>
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" style="display: block; margin-top: 0.75rem; opacity: 0.7; font-size: 0.9rem;">
        {{ article.published_at | date: '%B %d, %Y' }}
      </time>
    </header>

    {%- if article.image -%}
      <img
        src="{{ article.image | image_url: width: 1200 }}"
        alt="{{ article.image.alt | default: article.title | escape }}"
        width="1200"
        height="675"
        style="width: 100%; border-radius: 8px; margin-bottom: 2.5rem;"
      />
    {%- endif -%}

    <div class="page-body rte">
      {{ article.content }}
    </div>
  </div>
</article>

<!-- Article Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  {%- if article.image %}
  "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
  {%- endif %}
  "author": {
    "@type": "Organization",
    "name": "Dunn's Luxury Selections"
  },
  "publisher": { "@id": "{{ shop.url }}/#organization" },
  "mainEntityOfPage": "{{ shop.url }}{{ article.url }}"
}
</script>

<!-- Related Products + Newsletter -->
{% section 'featured-products' %}
{% section 'newsletter' %}
