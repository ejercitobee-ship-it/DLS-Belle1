<!-- Contact Page -->

<div class="contact-page">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <!-- Page Header -->
    <header class="contact-header mb-12">
      <h1 class="page-title">Get in Touch</h1>
      <p class="page-subtitle">We're here to help with any questions about our humidors or financing options.</p>
    </header>

    <!-- Contact Form -->
    <div class="contact-form-wrapper">
      <form class="contact-form" data-form-type="Contact" novalidate>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
          <!-- Personal Information -->
          <fieldset class="form-fieldset">
            <legend class="form-legend">Your Information</legend>

            <div class="form-group">
              <label for="contact-name" class="form-label">Name *</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                placeholder="Full Name"
                required
                class="form-input"
              />
            </div>

            <div class="form-group">
              <label for="contact-email" class="form-label">Email *</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                placeholder="you@example.com"
                required
                class="form-input"
              />
            </div>

            <div class="form-group">
              <label for="contact-phone" class="form-label">Phone (Optional)</label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                placeholder="+1 (555) 000-0000"
                class="form-input"
              />
            </div>
          </fieldset>

          <!-- Message -->
          <fieldset class="form-fieldset">
            <legend class="form-legend">Your Message</legend>

            <div class="form-group">
              <label for="contact-subject" class="form-label">Subject *</label>
              <select id="contact-subject" name="subject" required class="form-select">
                <option value="">Select a topic...</option>
                <option value="Product Inquiry">Product Inquiry</option>
                <option value="Financing Questions">Financing Questions</option>
                <option value="Order Status">Order Status</option>
                <option value="Returns & Warranty">Returns & Warranty</option>
                <option value="Care & Maintenance">Care & Maintenance</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label for="contact-message" class="form-label">Message *</label>
              <textarea
                id="contact-message"
                name="message"
                placeholder="Tell us how we can help..."
                required
                rows="6"
                class="form-textarea"
              ></textarea>
            </div>
          </fieldset>

          <!-- Privacy Notice -->
          <div class="form-notice">
            <p>
              <strong>Privacy:</strong> We respect your privacy. Your information will only be used to respond to your inquiry.
              <a href="/pages/privacy">Read our Privacy Policy</a>
            </p>
          </div>

          <!-- Submit Button -->
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Send Message</button>
            <p class="form-required">* Required fields</p>
          </div>

          <p class="contact-form-msg" role="status" aria-live="polite" style="margin-top:1rem;"></p>
      </form>
    </div>

    <!-- Contact Information -->
    <div class="contact-info-section mt-16 pt-12 border-t border-charcoal-800">
      <h2 class="section-heading">Other Ways to Reach Us</h2>

      <div class="contact-info-grid">
        <div class="contact-info-card">
          <div class="info-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
          <h3>Address</h3>
          <p>
            Dunn Luxury Selections<br/>
            [Your Address]<br/>
            [City, State ZIP]<br/>
            United States
          </p>
        </div>

        <div class="contact-info-card">
          <div class="info-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <h3>Phone</h3>
          <p>
            <a href="tel:+1-555-000-0000">+1 (555) 000-0000</a><br/>
            <span class="text-sm">Monday - Friday: 9am - 6pm EST</span><br/>
            <span class="text-sm">Saturday - Sunday: 10am - 4pm EST</span>
          </p>
        </div>

        <div class="contact-info-card">
          <div class="info-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <h3>Email</h3>
          <p>
            <a href="mailto:support@dunnluxuryselections.com">support@dunnluxuryselections.com</a><br/>
            <span class="text-sm">Typical response time: 2-4 hours</span><br/>
            <span class="text-sm">We're here to help!</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Newsletter Section -->
{% section 'newsletter' %}

<script>
  (function () {
    var LEAD_ENDPOINT = 'https://script.google.com/macros/s/AKfycbw3bkr1qS8wJ7GrQeqhp4UytVlSMPwtacyG3IkD0dxNmi36YoX5jU-hcBpRPqe3m8Jq/exec';
    var form = document.querySelector('.contact-form');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var msg = form.querySelector('.contact-form-msg');
      var btn = form.querySelector('button[type="submit"]');
      if (msg) { msg.textContent = ''; msg.classList.remove('err'); }

      // Honeypot: silently ignore bots
      if (form.website && form.website.value) return;

      var data = { formType: 'Contact' };
      new FormData(form).forEach(function (value, key) {
        value = String(value).trim();
        if (value && key !== 'website') data[key] = value;
      });

      if (!data.name || !data.email) {
        if (msg) { msg.textContent = 'Please fill in your name and email.'; msg.classList.add('err'); }
        return;
      }

      var label = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

      // Same proven pattern as the other lead forms: plain-text JSON, no-cors.
      fetch(LEAD_ENDPOINT, { method: 'POST', mode: 'no-cors', body: JSON.stringify(data) })
        .then(function () {
          if (window.gtag) {
            window.gtag('event', 'generate_lead', { 'value': 1, 'currency': 'USD', 'form_type': 'contact' });
          }
          var wrap = form.closest('.contact-form-wrapper') || form.parentNode;
          wrap.innerHTML =
            '<div class="form-success">' +
            '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>' +
            '<h2>Thank you for your message!</h2>' +
            '<p>We&rsquo;ll get back to you as soon as possible.</p></div>';
        })
        .catch(function () {
          if (msg) { msg.textContent = 'Something went wrong. Please call (888) 431-9214 or email support@dunnluxuryselections.com.'; msg.classList.add('err'); }
          if (btn) { btn.disabled = false; btn.textContent = label; }
        });
    });
  })();
</script>

