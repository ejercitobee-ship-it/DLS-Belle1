<!-- All Collections -->
<div class="page-wrapper">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <header class="page-header" style="margin-bottom: 3rem; text-align: center;">
      <h1 class="page-title">Our Collections</h1>
      <p style="opacity: 0.8; margin-top: 0.75rem;">Explore curated collections of luxury humidors and premium cigar accessories.</p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a href="{{ collection.url }}" class="collection-card">
            {%- if collection.featured_image -%}
              <img
                src="{{ collection.featured_image | image_url: width: 600 }}"
                alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                loading="lazy"
                width="600"
                height="400"
                style="width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 8px 8px 0 0;"
              />
            {%- endif -%}
            <div style="padding: 1.5rem;">
              <h2 style="margin: 0; font-size: 1.25rem;">{{ collection.title }}</h2>
              <p style="opacity: 0.7; font-size: 0.9rem; margin: 0.5rem 0 0;">
                {{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}
              </p>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<!-- Newsletter Signup -->
{% section 'newsletter' %}

<style>
  .collection-card {
    display: block;
    background: var(--charcoal-900);
    border: 1px solid rgba(201, 138, 16, 0.2);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .collection-card:hover {
    border-color: rgba(201, 138, 16, 0.5);
    transform: translateY(-2px);
  }
</style>
