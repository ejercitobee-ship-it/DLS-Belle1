{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ shop.name }} — Coming Soon</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  {{ 'main.css' | asset_url | stylesheet_tag }}
  <style>
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; text-align: center; }
    .password-wrapper { max-width: 520px; padding: 2rem; }
    .password-form input[type="password"] { width: 100%; padding: 0.75rem 1rem; margin-bottom: 1rem; background: var(--charcoal-900); border: 1px solid rgba(201, 138, 16, 0.3); border-radius: 4px; color: var(--cream-100); }
  </style>
</head>
<body class="bg-charcoal-950 text-cream-100">
  <div class="password-wrapper">
    <h1>{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- else -%}
      <p>Something exceptional is on the way. The world's finest humidor collections, opening soon.</p>
    {%- endif -%}

    {% form 'storefront_password', class: 'password-form' %}
      {%- if form.errors -%}
        <p class="text-gold">{{ form.errors.messages['form'] }}</p>
      {%- endif -%}
      <input type="password" name="password" placeholder="Enter store password" aria-label="Password" required />
      <button type="submit" class="btn btn-primary">Enter</button>
    {% endform %}
  </div>
</body>
</html>
