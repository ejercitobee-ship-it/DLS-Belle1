{%- comment -%}
  Inner Circle lead-capture popup — single step, 3 fields (Full name, Email, Phone).
  CLS-safe: position:fixed overlay (never shifts page flow) + triggers only AFTER
  engagement (scroll > 300px, exit-intent, or 45s fallback), so its appearance is
  never counted toward Cumulative Layout Shift. Shows once per session.
  Leads POST to the shared Google Apps Script → Google Sheet endpoint (formType
  "inner-circle"), same no-cors pattern as the other theme forms, ping Google Chat,
  fire a gtag generate_lead conversion, AND subscribe the lead to the Klaviyo "Inner
  Circle (Double Opt-In)" list (id XCX5a9) via the client subscriptions API, which
  triggers the "Welcome Series - VIP" flow. See memory: dls-belle1-core-web-vitals,
  dls-belle1-chat-lead-notifications, and dls-belle1-klaviyo-audit.
{%- endcomment -%}
<style>
  .dls-lp-overlay{position:fixed;inset:0;z-index:1000;display:none;align-items:center;justify-content:center;padding:1rem;background:rgba(10,10,12,.8);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
  .dls-lp-overlay.is-open{display:flex}
  .dls-lp-modal{position:relative;width:100%;max-width:26rem;background:var(--charcoal-900,#17181c);border:1px solid var(--charcoal-700,#3a3d45);border-radius:1rem;box-shadow:0 25px 50px -12px rgba(0,0,0,.6);padding:1.75rem;color:var(--cream-100,#f5f1e8);animation:dls-lp-in .3s ease}
  @keyframes dls-lp-in{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  .dls-lp-close{position:absolute;top:.75rem;right:.75rem;z-index:2;display:flex;align-items:center;justify-content:center;width:2rem;height:2rem;border:0;border-radius:.5rem;background:transparent;color:rgba(245,241,232,.5);cursor:pointer;transition:color .2s,background .2s}
  .dls-lp-close:hover{color:var(--cream-100,#f5f1e8);background:rgba(255,255,255,.06)}
  .dls-lp-head{text-align:center;margin-bottom:1.1rem}
  .dls-lp-eyebrow{font-size:.7rem;font-weight:600;letter-spacing:.28em;text-transform:uppercase;color:var(--gold-400,#d4af37);margin:0 0 .5rem}
  .dls-lp-title{font-family:var(--font-serif,'Playfair Display',serif);font-size:1.6rem;line-height:1.15;color:#fff;margin:0 0 .4rem}
  .dls-lp-title .dls-lp-accent{background:linear-gradient(90deg,var(--gold-400,#d4af37),var(--gold-600,#b8860b));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .dls-lp-sub{font-size:.875rem;line-height:1.45;color:rgba(245,241,232,.62);margin:0}
  .dls-lp-perks{list-style:none;margin:0 0 1.15rem;padding:0;display:flex;flex-direction:column;gap:.55rem}
  .dls-lp-perks li{display:flex;align-items:flex-start;gap:.6rem;font-size:.85rem;color:rgba(245,241,232,.85);line-height:1.35}
  .dls-lp-perks svg{flex:none;width:1.05rem;height:1.05rem;color:var(--gold-400,#d4af37);margin-top:.06rem}
  .dls-lp-field{width:100%;box-sizing:border-box;background:var(--charcoal-950,#0e0f12);border:1px solid var(--charcoal-700,#3a3d45);border-radius:.5rem;padding:.7rem 1rem;color:var(--cream-100,#f5f1e8);font-size:.9rem;margin-bottom:.7rem;transition:border-color .2s,box-shadow .2s}
  .dls-lp-field::placeholder{color:rgba(245,241,232,.35)}
  .dls-lp-field:focus{outline:none;border-color:var(--gold-500,#c9a227);box-shadow:0 0 0 3px rgba(201,162,39,.15)}
  .dls-lp-btn{width:100%;box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:.5rem;border:0;border-radius:.5rem;padding:.8rem 1rem;font-size:.92rem;font-weight:700;letter-spacing:.02em;cursor:pointer;background:linear-gradient(90deg,var(--gold-600,#b8860b),var(--gold-500,#c9a227));color:var(--charcoal-950,#0e0f12);box-shadow:0 8px 22px rgba(201,162,39,.28);transition:filter .2s,opacity .2s,transform .15s}
  .dls-lp-btn:hover{filter:brightness(1.08);transform:translateY(-1px)}
  .dls-lp-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
  .dls-lp-ghost{width:100%;border:0;background:transparent;color:rgba(245,241,232,.5);font-size:.85rem;padding:.5rem;margin-top:.35rem;cursor:pointer;transition:color .2s}
  .dls-lp-ghost:hover{color:rgba(245,241,232,.85)}
  .dls-lp-fine{font-size:.72rem;color:rgba(245,241,232,.3);text-align:center;margin:.9rem 0 0}
  .dls-lp-err{display:none;font-size:.82rem;color:#f87171;background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.2);border-radius:.5rem;padding:.5rem .75rem;margin-bottom:.75rem}
  .dls-lp-hp{position:absolute!important;left:-9999px!important;width:1px;height:1px;opacity:0}
  .dls-lp-success{text-align:center;padding:1.5rem 0}
  .dls-lp-success svg{width:3.25rem;height:3.25rem;color:var(--gold-400,#d4af37);margin:0 auto 1rem;display:block}
</style>

<div class="dls-lp-overlay" id="dls-lead-popup" role="dialog" aria-modal="true" aria-labelledby="dls-lp-title" aria-hidden="true">
  <div class="dls-lp-modal">
    <button type="button" class="dls-lp-close" data-lp-dismiss aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="dls-lp-body">
      <div class="dls-lp-head">
        <p class="dls-lp-eyebrow">By Invitation</p>
        <h3 class="dls-lp-title" id="dls-lp-title">Join the <span class="dls-lp-accent">Inner Circle</span></h3>
        <p class="dls-lp-sub">The private list for serious collectors — first access, expert guidance, and members-only offers.</p>
      </div>

      <ul class="dls-lp-perks">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          First access to new &amp; pre-release humidors
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          A private concierge &amp; expert consultation
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Members-only previews &amp; exclusive offers
        </li>
      </ul>

      <div class="dls-lp-err" id="dls-lp-err"></div>

      <form class="dls-lp-form" id="dls-lp-form" novalidate>
        <input class="dls-lp-field" type="text" name="name" id="dls-lp-name" placeholder="Full name" autocomplete="name" required>
        <input class="dls-lp-field" type="email" name="email" id="dls-lp-email" placeholder="Email address" autocomplete="email" required>
        <input class="dls-lp-field" type="tel" name="phone" id="dls-lp-phone" placeholder="Phone number" autocomplete="tel" required>
        <input class="dls-lp-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button class="dls-lp-btn" type="submit" id="dls-lp-submit">Claim My Access
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <button class="dls-lp-ghost" type="button" data-lp-skip>Maybe later</button>
      </form>

      <p class="dls-lp-fine">No spam, ever. Unsubscribe anytime.</p>
    </div>

    <!-- Success -->
    <div class="dls-lp-success" id="dls-lp-success" style="display:none">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <h3 class="dls-lp-title">Welcome to the Inner Circle</h3>
      <p class="dls-lp-sub">You're on the list. Our team will reach out with your first-access previews shortly.</p>
      <button class="dls-lp-btn" type="button" data-lp-dismiss style="margin-top:1.25rem;max-width:10rem;margin-left:auto;margin-right:auto">Close</button>
    </div>
  </div>
</div>

<script>
  (function () {
    var LEAD_ENDPOINT = 'https://script.google.com/macros/s/AKfycbw3bkr1qS8wJ7GrQeqhp4UytVlSMPwtacyG3IkD0dxNmi36YoX5jU-hcBpRPqe3m8Jq/exec';
    // Instant Chat heads-up posted from the browser (Apps Script can't call
    // Google's own Chat API — returns API_KEY_INVALID). Fire-and-forget.
    var CHAT_WEBHOOK = 'https://chat.googleapis.com/v1/spaces/AAQAJQZfKTI/messages?key=AIzaSyDdI0hCZtE6vySjMm-WEfRq3CPzqKqqsHI&token=qHgGguu_2oJoYXLqU6mV-aIVS9H7GUsE_veiGPzJ1pw';
    function pingChat(data) {
      try {
        var m = '*🔔 New Lead — ' + (data.formType || 'Website') + '*';
        Object.keys(data).forEach(function (k) {
          if (k === 'website' || k === 'formType') return;
          if (data[k]) m += '\n*' + k.charAt(0).toUpperCase() + k.slice(1) + ':* ' + data[k];
        });
        fetch(CHAT_WEBHOOK, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: m }) });
      } catch (e) {}
    }

    // Subscribe the lead to the Klaviyo "Inner Circle" list (double opt-in) →
    // triggers the "Welcome Series - VIP" flow. Fire-and-forget; never blocks the
    // existing Sheet/Chat lead capture. company_id is Klaviyo's PUBLIC key.
    function subscribeKlaviyo(name, email, pd) {
      try {
        var parts = (name || '').trim().split(/\s+/);
        var fn = parts.shift() || '';
        var ln = parts.join(' ');
        var attrs = { email: email, first_name: fn, last_name: ln };
        if (pd) attrs.phone_number = '+1' + pd;
        fetch('https://a.klaviyo.com/client/subscriptions/?company_id=Wp37xM', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', revision: '2024-10-15' },
          body: JSON.stringify({
            data: {
              type: 'subscription',
              attributes: {
                custom_source: 'Inner Circle popup',
                profile: { data: { type: 'profile', attributes: attrs } }
              },
              relationships: { list: { data: { type: 'list', id: 'XCX5a9' } } }
            }
          })
        });
      } catch (e) {}
    }

    var KEY = 'dlsLeadPopup';                 // 'seen' guard for this session
    var overlay = document.getElementById('dls-lead-popup');
    if (!overlay) return;
    if (sessionStorage.getItem(KEY)) return;  // already shown/handled this session

    var opened = false, delayTimer = null;

    // Tawk chat renders above everything and would overlap the popup's submit
    // button — hide it while the popup is open (handles Tawk loading either
    // before OR after the popup opens), restore it on close.
    function hideTawk() {
      try {
        window.Tawk_API = window.Tawk_API || {};
        if (window.Tawk_API.hideWidget) window.Tawk_API.hideWidget();
        var prev = window.Tawk_API.onLoad;
        window.Tawk_API.onLoad = function () {
          if (typeof prev === 'function') { try { prev(); } catch (e) {} }
          try { if (overlay.classList.contains('is-open') && window.Tawk_API.hideWidget) window.Tawk_API.hideWidget(); } catch (e) {}
        };
      } catch (e) {}
    }
    function showTawk() {
      try { if (window.Tawk_API && window.Tawk_API.showWidget) window.Tawk_API.showWidget(); } catch (e) {}
    }

    function show() {
      if (opened) return;
      opened = true;
      sessionStorage.setItem(KEY, '1');
      clearTimeout(delayTimer);
      removeTriggers();
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      hideTawk();
      var f = document.getElementById('dls-lp-name');
      if (f) { try { f.focus(); } catch (e) {} }
    }
    function dismiss() {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      showTawk();
    }
    function onScroll() { if ((window.scrollY || window.pageYOffset) > 300) show(); }
    function onMouseOut(e) { if (e.clientY <= 5) show(); } // desktop exit-intent
    function removeTriggers() {
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('mouseout', onMouseOut);
    }

    // Triggers (all fire AFTER engagement → CLS-safe). Fixed overlay = no layout shift regardless.
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('mouseout', onMouseOut);
    delayTimer = setTimeout(show, 45000);

    function showErr(msg) {
      var el = document.getElementById('dls-lp-err');
      el.textContent = msg; el.style.display = 'block';
    }
    function clearErr() { var el = document.getElementById('dls-lp-err'); el.style.display = 'none'; }

    document.getElementById('dls-lp-form').addEventListener('submit', function (e) {
      e.preventDefault();
      clearErr();

      // honeypot
      var hp = overlay.querySelector('input[name="website"]');
      if (hp && hp.value) { dismiss(); return; }

      var name = document.getElementById('dls-lp-name').value.trim();
      var email = document.getElementById('dls-lp-email').value.trim();
      var phone = document.getElementById('dls-lp-phone').value.trim();

      if (!name) { showErr('Please enter your full name.'); return; }
      if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(email)) { showErr('Please enter a valid email address.'); return; }
      var pd = phone.replace(/\D/g, '').replace(/^1(\d{10})$/, '$1');
      if (!(/^[2-9]\d{2}[2-9]\d{6}$/.test(pd) && !/^(\d)\1{9}$/.test(pd))) { showErr('Please enter a valid phone number.'); return; }

      var btn = document.getElementById('dls-lp-submit');
      btn.disabled = true; btn.textContent = 'Sending…';

      var payload = { formType: 'inner-circle', name: name, email: email, phone: phone };
      fetch(LEAD_ENDPOINT, { method: 'POST', mode: 'no-cors', body: JSON.stringify(payload) })
        .then(function () {
          pingChat(payload);
          subscribeKlaviyo(name, email, pd);
          try {
            if (window.gtag) window.gtag('event', 'generate_lead', { value: 1, currency: 'USD', form_type: 'inner-circle' });
          } catch (e) {}
          document.querySelector('.dls-lp-body').style.display = 'none';
          document.getElementById('dls-lp-success').style.display = 'block';
        })
        .catch(function () {
          btn.disabled = false; btn.textContent = 'Claim My Access';
          showErr('Something went wrong. Please try again.');
        });
    });

    // Dismiss (X, Close, Maybe later, backdrop, Esc)
    overlay.querySelectorAll('[data-lp-dismiss],[data-lp-skip]').forEach(function (b) {
      b.addEventListener('click', dismiss);
    });
    overlay.addEventListener('click', function (e) { if (e.target === overlay) dismiss(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && overlay.classList.contains('is-open')) dismiss(); });
  })();
</script>
