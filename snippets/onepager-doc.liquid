  <script>
    (function () {
      // ── Lightbox ──
      var lightbox = document.getElementById('lightbox');
      var lightboxImg = lightbox.querySelector('img');
      var lightboxClose = lightbox.querySelector('.lightbox-close');

      document.querySelectorAll('.gallery figure').forEach(function (fig) {
        fig.addEventListener('click', function () {
          var img = fig.querySelector('img');
          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt;
          lightbox.classList.add('active');
        });
      });

      lightboxClose.addEventListener('click', function () {
        lightbox.classList.remove('active');
      });

      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) lightbox.classList.remove('active');
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && lightbox.classList.contains('active')) {
          lightbox.classList.remove('active');
        }
      });

      // ── Tabs ──
      var tabs = document.querySelectorAll('.tab');
      var panels = document.querySelectorAll('.panel');
      var NAMES = ['walkin', 'cabinets', 'showcases'];
      function activate(name, updateUrl) {
        tabs.forEach(function (t) {
          var on = t.dataset.panel === name;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function (p) {
          var on = p.id === 'panel-' + name;
          p.classList.toggle('active', on);
          p.hidden = !on;
        });
        if (updateUrl && history.replaceState) history.replaceState(null, '', '/onepager/' + name);
      }
      tabs.forEach(function (t) {
        t.addEventListener('click', function () {
          activate(t.dataset.panel, true);
          // keep the reader at the top of the newly selected panel
          var bar = document.querySelector('.tabbar');
          var y = bar.getBoundingClientRect().top + window.scrollY;
          if (window.scrollY > y) window.scrollTo({ top: y, behavior: 'instant' });
        });
      });
      // initial tab from /onepager/<name> path, with legacy #<name> fallback
      var fromPath = (location.pathname.match(/\/onepager\/([a-z-]+)/) || [])[1];
      var fromHash = location.hash.replace('#', '');
      var initial = NAMES.indexOf(fromPath) !== -1 ? fromPath : NAMES.indexOf(fromHash) !== -1 ? fromHash : null;
      if (initial) activate(initial, fromHash === initial);

      // ── Project inquiry forms → Google Sheet (Apps Script Web App) ──
      var LEAD_ENDPOINT = 'https://script.google.com/macros/s/AKfycbw3bkr1qS8wJ7GrQeqhp4UytVlSMPwtacyG3IkD0dxNmi36YoX5jU-hcBpRPqe3m8Jq/exec';
      // Instant heads-up to the internal Google Chat space. Apps Script itself
      // can't call Google's own Chat API (credential conflict), so we post from
      // the browser, which works. Fire-and-forget — never blocks the form.
      var CHAT_WEBHOOK = 'https://chat.googleapis.com/v1/spaces/AAQAJQZfKTI/messages?key=AIzaSyDdI0hCZtE6vySjMm-WEfRq3CPzqKqqsHI&token=qHgGguu_2oJoYXLqU6mV-aIVS9H7GUsE_veiGPzJ1pw';
      function pingChat(data) {
        try {
          var m = '*🔔 New Lead — ' + (data.formType || 'Website') + '*';
          Object.keys(data).forEach(function (k) {
            if (k === 'website' || k === 'formType') return;
            if (data[k]) m += '\n*' + k.charAt(0).toUpperCase() + k.slice(1) + ':* ' + data[k];
          });
          fetch(CHAT_WEBHOOK, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: m }) });
        } catch (e) {}
      }
      document.querySelectorAll('.inquiry-form').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var msg = form.querySelector('.form-msg');
          var btn = form.querySelector('button[type="submit"]');
          msg.textContent = '';
          msg.classList.remove('err');

          // collect fields; checkboxes with the same name join into one value
          var data = { formType: form.dataset.formType };
          var fd = new FormData(form);
          fd.forEach(function (value, key) {
            value = String(value).trim();
            if (!value) return;
            data[key] = data[key] ? data[key] + ', ' + value : value;
          });

          var emailOk = /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(data.email || '');
          var phoneDigits = (data.phone || '').replace(/\D/g, '').replace(/^1(\d{10})$/, '$1');
          var phoneOk = !data.phone || (/^[2-9]\d{2}[2-9]\d{6}$/.test(phoneDigits) && !/^(\d)\1{9}$/.test(phoneDigits));

          if (!data.firstName || !data.email) {
            msg.textContent = 'Please fill in your name and email.';
            msg.classList.add('err');
            return;
          }
          if (!emailOk) {
            msg.textContent = 'Please enter a valid email address.';
            msg.classList.add('err');
            return;
          }
          if (!phoneOk) {
            msg.textContent = 'Please enter a valid phone number.';
            msg.classList.add('err');
            return;
          }

          btn.disabled = true;
          var label = btn.textContent;
          btn.textContent = 'Sending…';

          // Google Apps Script Web Apps don't return CORS headers, so we POST
          // with mode:'no-cors' (opaque response — can't be read) and treat a
          // resolved request as success. The body is a plain-text JSON string,
          // which avoids a CORS preflight; Apps Script reads e.postData.contents.
          fetch(LEAD_ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            body: JSON.stringify(data),
          })
            .then(function () {
              pingChat(data);
              // Track form submission as a conversion in Google Ads
              if (typeof window !== 'undefined' && window.gtag) {
                window.gtag('event', 'generate_lead', {
                  'value': 1,
                  'currency': 'USD',
                  'form_type': form.dataset.formType || 'inquiry',
                });
              }
              form.parentElement.innerHTML =
                '<div class="form-success"><div class="tick">✓</div>' +
                '<h4>Thank you — request received.</h4>' +
                '<p>A specialist will contact you within one business day to discuss your project.</p></div>';
            })
            .catch(function () {
              msg.textContent = 'Something went wrong. Please call (888) 431-9214 or email support@dunnluxuryselections.com.';
              msg.classList.add('err');
              btn.disabled = false;
              btn.textContent = label;
            });
        });
      });
    })();
  </script>
