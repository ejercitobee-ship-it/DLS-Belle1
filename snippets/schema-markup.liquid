{%- comment -%}
JSON-LD Schema Markup for SEO — rendered from layout/theme.liquid <head>.

Replicates the schema the headless site (main branch) serves live:
- Organization (deliberately NOT OnlineStore/LocalBusiness — OnlineStore is a
  LocalBusiness subtype and makes Google classify the site as a local business)
- WebSite
- Product + BreadcrumbList on product pages

Never add bare {"@type":"Product"} stubs to org-level schema.
{%- endcomment -%}

<!-- Organization Schema (all pages) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "{{ shop.url }}/#organization",
  "name": "Dunn's Luxury Selections",
  "url": "{{ shop.url }}",
  "logo": "{{ 'logo.png' | asset_url }}",
  "description": "America's premier destination for luxury humidors — cabinet, electronic, desktop, and travel humidors — plus custom walk-in humidor design with nationwide component shipping and installation guidance.",
  "email": "support@dunnluxuryselections.com",
  "telephone": "+1-888-431-9214",
  "sameAs": [
    "https://www.facebook.com/dunnsluxuryselections",
    "https://www.instagram.com/dunnsluxuryselections",
    "https://www.twitter.com/dunnsluxury"
  ],
  "foundingDate": "2020",
  "areaServed": {
    "@type": "Country",
    "name": "United States"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "telephone": "+1-888-431-9214",
    "email": "support@dunnluxuryselections.com"
  }
}
</script>

<!-- WebSite Schema (all pages) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Dunn's Luxury Selections",
  "url": "{{ shop.url }}",
  "description": "The World's Finest Humidor Collections — shop curated collections of bespoke humidors, cabinet humidors, electronic humidors, travel humidors, and premium cigar accessories.",
  "publisher": { "@id": "{{ shop.url }}/#organization" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

<!-- Product Schema (product pages only) -->
{%- if template.name == 'product' and product -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncatewords: 100 | json }},
    "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
    "url": "{{ shop.url }}{{ product.url }}",
    "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | default: shop.name | json }}
    },
    "offers": {
      "@type": "Offer",
      "url": "{{ shop.url }}{{ product.url }}",
      "priceCurrency": {{ cart.currency.iso_code | default: 'USD' | json }},
      "price": "{{ product.price | divided_by: 100.0 }}",
      "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "seller": { "@id": "{{ shop.url }}/#organization" }
    }
  }
  </script>

  <!-- BreadcrumbList Schema (product pages) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ shop.url }}"
      },
      {%- if collection -%}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ shop.url }}{{ collection.url }}"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": "{{ shop.url }}{{ product.url }}"
      }
      {%- else -%}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": "{{ shop.url }}{{ product.url }}"
      }
      {%- endif -%}
    ]
  }
  </script>
{%- endif -%}

<!-- BreadcrumbList Schema (collection pages) -->
{%- if template.name == 'collection' and collection -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ shop.url }}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ shop.url }}{{ collection.url }}"
      }
    ]
  }
  </script>
{%- endif -%}
