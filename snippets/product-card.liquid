{%- comment -%}
Product card — replicates the headless ProductCard.tsx design:
square contained image, "New" pill, sequence number, hover "View Product"
overlay, vendor eyebrow, 5-star row, price + gold Add button.

Params: product (required), index (optional), show_new_badge (optional bool)
{%- endcomment -%}

{%- liquid
  assign card_product = product
  assign card_variant = card_product.selected_or_first_available_variant
-%}

<div class="pcard">
  <!-- Image -->
  <a href="{{ card_product.url }}" class="pcard__media" aria-label="{{ card_product.title | escape }}">
    {%- if card_product.featured_image -%}
      <img
        src="{{ card_product.featured_image | image_url: width: 600 }}"
        alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
        loading="lazy"
        width="600"
        height="600"
        class="pcard__img"
      />
    {%- else -%}
      <div class="pcard__placeholder"></div>
    {%- endif -%}

    {%- if show_new_badge -%}
      <span class="pcard__badge-new">&#10022; New</span>
    {%- endif -%}

    {%- if card_product.compare_at_price > card_product.price -%}
      <span class="pcard__badge-sale">Sale</span>
    {%- endif -%}

    {%- if index -%}
      <span class="pcard__seq">{{ index | prepend: '00' | slice: -2, 2 }}</span>
    {%- endif -%}

    {%- if card_product.available -%}
      <div class="pcard__overlay"><span>View Product</span></div>
    {%- else -%}
      <div class="pcard__soldout"><span>Out of Stock</span></div>
    {%- endif -%}
  </a>

  <!-- Info -->
  <div class="pcard__info">
    {%- if card_product.type != blank -%}
      <p class="pcard__type">{{ card_product.type }}</p>
    {%- endif -%}
    <h3 class="pcard__title"><a href="{{ card_product.url }}">{{ card_product.title }}</a></h3>

    <div class="pcard__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <svg width="11" height="11" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1l3.09 6.26L20 7.24l-5 4.87 1.18 6.88L10 15.77l-6.18 3.25L5 12.11 0 7.24l6.91-1.01L10 1z" /></svg>
      {%- endfor -%}
    </div>

    <div class="pcard__row">
      <span class="pcard__price">{{ card_product.price | money }}</span>
      {%- if card_product.available and card_variant -%}
        <form method="post" action="/cart/add" class="pcard__add-form">
          <input type="hidden" name="id" value="{{ card_variant.id }}" />
          <button type="submit" class="pcard__add" aria-label="Add {{ card_product.title | escape }} to cart">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            <span>Add</span>
          </button>
        </form>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.pcard {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--charcoal-950);
  border: 1px solid rgba(70, 62, 59, 0.5);
  border-radius: 0.75rem;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
}

.pcard:hover {
  border-color: rgba(164, 108, 12, 0.5);
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(87, 54, 20, 0.1);
}

.pcard__media {
  position: relative;
  display: block;
  aspect-ratio: 1 / 1;
  background: #ffffff;
  overflow: hidden;
}

.pcard__title a {
  color: inherit;
  text-decoration: none;
}

.pcard__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 1rem;
  transition: transform 0.5s ease;
}

.pcard:hover .pcard__img {
  transform: scale(1.05);
}

/* On small screens the tile is small, so square/edge-filling product photos
   (e.g. the RR980) look oversized. Extra padding gives every product
   consistent breathing room from the frame. */
@media (max-width: 639px) {
  .pcard__img { padding: 1.5rem; }
}

.pcard__placeholder {
  width: 100%;
  height: 100%;
  background: #efe9e0;
}

.pcard__badge-new {
  position: absolute;
  top: 0.6rem;
  left: 0.6rem;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  background: var(--charcoal-950);
  color: var(--gold-400);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 0.25rem 0.6rem;
  border-radius: 9999px;
  border: 1px solid rgba(164, 108, 12, 0.4);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
}

.pcard__badge-sale {
  position: absolute;
  top: 0.6rem;
  right: 0.6rem;
  background: var(--gold-500);
  color: var(--charcoal-950);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 0.25rem 0.6rem;
  border-radius: 9999px;
}

.pcard__seq {
  position: absolute;
  bottom: 0.6rem;
  right: 0.75rem;
  font-family: ui-monospace, monospace;
  font-size: 10px;
  color: var(--charcoal-600);
  user-select: none;
}

.pcard__overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0);
  transition: background 0.3s ease;
  pointer-events: none;
}

.pcard__overlay span {
  color: white;
  opacity: 0;
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 500;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  transition: opacity 0.3s ease;
}

.pcard:hover .pcard__overlay {
  background: rgba(0, 0, 0, 0.35);
}

.pcard:hover .pcard__overlay span {
  opacity: 0.85;
}

.pcard__soldout {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(33, 30, 28, 0.6);
}

.pcard__soldout span {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(240, 221, 184, 0.6);
  background: rgba(61, 54, 52, 0.8);
  padding: 0.4rem 0.8rem;
  border-radius: 0.25rem;
}

.pcard__info {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.pcard__type {
  color: rgba(201, 138, 16, 0.6);
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  margin: 0 0 0.25rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pcard__title {
  color: var(--cream-100);
  font-size: 0.85rem;
  font-weight: 500;
  line-height: 1.4;
  margin: 0 0 0.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color 0.2s ease;
}

.pcard:hover .pcard__title {
  color: white;
}

.pcard__stars {
  display: flex;
  gap: 2px;
  color: var(--gold-500);
}

.pcard__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-top: auto;
  padding-top: 0.65rem;
}

.pcard__price {
  color: white;
  font-weight: 700;
  font-size: 0.95rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pcard__add-form {
  margin: 0;
  flex-shrink: 0;
}

.pcard__add {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 0.4rem 0.7rem;
  border: none;
  border-radius: 0.5rem;
  cursor: pointer;
  background: linear-gradient(135deg, var(--gold-600) 0%, var(--gold-500) 50%, var(--gold-700) 100%);
  color: var(--charcoal-950);
  transition: opacity 0.2s ease, transform 0.1s ease;
}

.pcard__add:hover {
  opacity: 0.9;
}

.pcard__add:active {
  transform: scale(0.95);
}
{% endstylesheet %}
