{%- liquid
  assign product_card_product = product
-%}

<div class="product-card">
  <div class="product-card__image-wrapper">
    {%- if product_card_product.featured_image -%}
      <a href="{{ product_card_product.url }}" class="product-card__image-link">
        <img
          src="{{ product_card_product.featured_image | img_url: '500x500' }}"
          alt="{{ product_card_product.featured_image.alt | escape }}"
          loading="lazy"
          width="500"
          height="500"
          class="product-card__image"
        />
      </a>
    {%- else -%}
      <a href="{{ product_card_product.url }}" class="product-card__image-link">
        <div class="product-card__placeholder">
          <svg class="placeholder-svg" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      </a>
    {%- endif -%}

    {%- if product_card_product.available == false -%}
      <span class="product-card__badge badge--sold-out">Sold out</span>
    {%- elsif product_card_product.compare_at_price > product_card_product.price -%}
      <span class="product-card__badge badge--sale">Sale</span>
    {%- endif -%}
  </div>

  <div class="product-card__content">
    <h3 class="product-card__title">
      <a href="{{ product_card_product.url }}">{{ product_card_product.title }}</a>
    </h3>

    <div class="product-card__price">
      {%- if product_card_product.price_varies -%}
        <span class="price__label">From</span>
      {%- endif -%}
      <span class="price">{{ product_card_product.price | money }}</span>

      {%- if product_card_product.compare_at_price > product_card_product.price -%}
        <span class="price price--sale">{{ product_card_product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>

    {%- if product_card_product.description != blank -%}
      <p class="product-card__description">
        {{ product_card_product.description | strip_html | truncatewords: 15 }}
      </p>
    {%- endif -%}

    <a href="{{ product_card_product.url }}" class="product-card__link">
      View Details →
    </a>
  </div>
</div>

{% stylesheet %}
.product-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--charcoal-900);
  border: 1px solid rgba(229, 165, 36, 0.1);
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}

.product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  border-color: rgba(229, 165, 36, 0.3);
}

.product-card__image-wrapper {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1 / 1;
  background: var(--charcoal-800);
}

.product-card__image-link {
  display: block;
  width: 100%;
  height: 100%;
  text-decoration: none;
}

.product-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.product-card:hover .product-card__image {
  transform: scale(1.05);
}

.product-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #463e3b 0%, #3d3634 100%);
}

.placeholder-svg {
  width: 4rem;
  height: 4rem;
  color: rgba(240, 221, 184, 0.3);
}

.product-card__content {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex: 1;
}

.product-card__title {
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.3;
  margin: 0;
}

.product-card__title a {
  color: var(--cream-100);
  text-decoration: none;
  transition: color 0.3s ease;
}

.product-card__title a:hover {
  color: var(--gold-400);
}

.product-card__price {
  display: flex;
  gap: 0.5rem;
  align-items: center;
  flex-wrap: wrap;
}

.price__label {
  font-size: 0.85rem;
  color: rgba(240, 221, 184, 0.6);
}

.price {
  font-weight: 600;
  color: var(--gold-400);
  font-size: 1.1rem;
}

.price--sale {
  text-decoration: line-through;
  color: rgba(240, 221, 184, 0.5);
  font-weight: normal;
  font-size: 0.9rem;
}

.product-card__description {
  font-size: 0.9rem;
  color: rgba(240, 221, 184, 0.7);
  line-height: 1.4;
  margin: 0;
  flex: 1;
}

.product-card__badge {
  position: absolute;
  top: 1rem;
  right: 1rem;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  z-index: 1;
}

.badge--sale {
  background: var(--gold-400);
  color: var(--charcoal-950);
}

.badge--sold-out {
  background: var(--charcoal-700);
  color: var(--cream-100);
  border: 1px solid rgba(240, 221, 184, 0.3);
}

.product-card__link {
  color: var(--gold-400);
  text-decoration: none;
  font-weight: 500;
  margin-top: auto;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(229, 165, 36, 0.2);
  display: inline-block;
  transition: color 0.3s ease;
  font-size: 0.95rem;
}

.product-card__link:hover {
  color: var(--gold-300);
  text-decoration: underline;
}

@media (max-width: 768px) {
  .product-card__content {
    padding: 1.25rem;
  }

  .product-card__title {
    font-size: 0.95rem;
  }

  .placeholder-svg {
    width: 3rem;
    height: 3rem;
  }
}
{% endstylesheet %}
