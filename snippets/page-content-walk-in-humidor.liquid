<script>
  (function () {
    var LEAD_ENDPOINT = 'https://script.google.com/macros/s/AKfycbw3bkr1qS8wJ7GrQeqhp4UytVlSMPwtacyG3IkD0dxNmi36YoX5jU-hcBpRPqe3m8Jq/exec';
    // Instant Chat heads-up posted from the browser (Apps Script can't call
    // Google's own Chat API). Fire-and-forget — never blocks the submission.
    var CHAT_WEBHOOK = 'https://chat.googleapis.com/v1/spaces/AAQAJQZfKTI/messages?key=AIzaSyDdI0hCZtE6vySjMm-WEfRq3CPzqKqqsHI&token=qHgGguu_2oJoYXLqU6mV-aIVS9H7GUsE_veiGPzJ1pw';
    function pingChat(data) {
      try {
        var m = '*🔔 New Lead — ' + (data.formType || 'Website') + '*';
        Object.keys(data).forEach(function (k) {
          if (k === 'website' || k === 'formType') return;
          if (data[k]) m += '\n*' + k.charAt(0).toUpperCase() + k.slice(1) + ':* ' + data[k];
        });
        fetch(CHAT_WEBHOOK, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: m }) });
      } catch (e) {}
    }
    var form = document.querySelector('.wih-consult-form');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var msg = form.querySelector('.wih-form-msg');
      var btn = form.querySelector('button[type="submit"]');
      msg.textContent = '';
      msg.classList.remove('err');

      var data = { formType: form.dataset.formType };
      new FormData(form).forEach(function (value, key) {
        value = String(value).trim();
        if (value) data[key] = data[key] ? data[key] + ', ' + value : value;
      });

      if (!data.firstName || !data.email) {
        msg.textContent = 'Please fill in your name and email.';
        msg.classList.add('err');
        return;
      }

      var label = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Sending…';

      // Same pattern as the one-pager: plain-text JSON, no-cors (Apps Script
      // returns no CORS headers), opaque response treated as success.
      fetch(LEAD_ENDPOINT, { method: 'POST', mode: 'no-cors', body: JSON.stringify(data) })
        .then(function () {
          pingChat(data);
          if (window.gtag) {
            window.gtag('event', 'generate_lead', {
              'value': 1,
              'currency': 'USD',
              'form_type': form.dataset.formType || 'walkin-consultation',
            });
          }
          var card = form.closest('.dls-card');
          if (card) {
            card.innerHTML =
              '<div class="wih-form-success"><div class="tick">&#10003;</div>' +
              '<h3 style="font-family: \'Playfair Display\', serif; color: #fff; margin: 0 0 0.5rem;">Thank you &mdash; request received.</h3>' +
              '<p class="dls-muted" style="margin: 0;">A specialist will contact you within one business day to discuss your project.</p></div>';
          }
        })
        .catch(function () {
          msg.textContent = 'Something went wrong. Please call (888) 431-9214 or email support@dunnluxuryselections.com.';
          msg.classList.add('err');
          btn.disabled = false;
          btn.textContent = label;
        });
    });
  })();
</script>

<script>
  (function () {
    var LEAD_ENDPOINT = 'https://script.google.com/macros/s/AKfycbw3bkr1qS8wJ7GrQeqhp4UytVlSMPwtacyG3IkD0dxNmi36YoX5jU-hcBpRPqe3m8Jq/exec';
    var CHAT_WEBHOOK = 'https://chat.googleapis.com/v1/spaces/AAQAJQZfKTI/messages?key=AIzaSyDdI0hCZtE6vySjMm-WEfRq3CPzqKqqsHI&token=qHgGguu_2oJoYXLqU6mV-aIVS9H7GUsE_veiGPzJ1pw';
    function pingChat(data) {
      try {
        var m = '*🔔 New Lead — ' + (data.formType || 'Website') + '*';
        Object.keys(data).forEach(function (k) {
          if (k === 'website' || k === 'formType') return;
          if (data[k]) m += '\n*' + k.charAt(0).toUpperCase() + k.slice(1) + ':* ' + data[k];
        });
        fetch(CHAT_WEBHOOK, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: m }) });
      } catch (e) {}
    }
    var GUIDE_URL = '{{ 'buyer-guide.pdf' | asset_url }}';
    var GUIDE_FILENAME = 'Dunns-Luxury-Selections-Humidor-Buyers-Guide.pdf';
    var modal = document.getElementById('guideModal');
    var form = modal ? modal.querySelector('.guide-form') : null;
    if (!modal || !form) return;

    var lastFocus = null;
    function openModal() {
      lastFocus = document.activeElement;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      var first = form.querySelector('input[name="firstName"]');
      if (first) first.focus();
    }
    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    document.querySelectorAll('.guide-open').forEach(function (b) { b.addEventListener('click', openModal); });
    modal.querySelectorAll('[data-guide-close]').forEach(function (b) { b.addEventListener('click', closeModal); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) closeModal(); });

    function downloadGuide() {
      var a = document.createElement('a');
      a.href = GUIDE_URL;
      a.setAttribute('download', GUIDE_FILENAME);
      a.target = '_blank';
      a.rel = 'noopener';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var msg = form.querySelector('.guide-msg');
      var btn = form.querySelector('button[type="submit"]');
      msg.textContent = '';
      msg.classList.remove('err');

      var data = { formType: form.dataset.formType };
      new FormData(form).forEach(function (value, key) {
        value = String(value).trim();
        if (value) data[key] = value;
      });

      if (!data.firstName || !data.email) {
        msg.textContent = 'Please enter your name and email.';
        msg.classList.add('err');
        return;
      }

      var label = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Preparing…';

      // Same Google Sheet endpoint / no-cors pattern as the other forms.
      fetch(LEAD_ENDPOINT, { method: 'POST', mode: 'no-cors', body: JSON.stringify(data) })
        .then(function () {
          pingChat(data);
          if (window.gtag) {
            window.gtag('event', 'generate_lead', { 'value': 1, 'currency': 'USD', 'form_type': 'buyers-guide' });
          }
          downloadGuide();
          var panel = modal.querySelector('.guide-modal__panel');
          panel.innerHTML =
            '<button type="button" class="guide-modal__close" data-guide-close aria-label="Close">&#10005;</button>' +
            '<div class="wih-form-success"><div class="tick">&#10003;</div>' +
            '<h3 style="font-family: \'Playfair Display\', Georgia, serif; color: #fff; margin: 0 0 0.5rem;">Your guide is downloading.</h3>' +
            '<p class="dls-muted" style="margin: 0 0 1.25rem;">If it didn\'t start automatically, use the button below.</p>' +
            '<a href="' + GUIDE_URL + '" target="_blank" rel="noopener" class="btn btn-primary" download="' + GUIDE_FILENAME + '">Download the Guide</a></div>';
          panel.querySelectorAll('[data-guide-close]').forEach(function (b) { b.addEventListener('click', closeModal); });
        })
        .catch(function () {
          msg.textContent = 'Something went wrong. Please call (888) 431-9214.';
          msg.classList.add('err');
          btn.disabled = false;
          btn.textContent = label;
        });
    });
  })();
</script>
