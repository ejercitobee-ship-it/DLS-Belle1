<!-- Intro strip -->
<section style="background: var(--charcoal-900); border-top: 1px solid rgba(70, 62, 59, 0.5); border-bottom: 1px solid rgba(70, 62, 59, 0.5); padding: 3rem 0;">
  <div class="dls-container" style="text-align: center;">
    <p class="dls-muted" style="font-size: 1.05rem; margin: 0;">At <strong>Dunn's Luxury Selections</strong>, we specialise in transforming rooms into world-class preservation sanctuaries. Whether you are a private collector building a dedicated home cigar lounge or a business owner requiring a high-capacity commercial walk-in, our team provides the expertise to maintain a perfect, climate-controlled environment.</p>
  </div>
</section>

<!-- Three Pillars -->
<section class="dls-page">
  <div class="dls-container dls-container--wide">
    <div style="text-align: center; margin-bottom: 4rem;">
      <div class="dls-eyebrow dls-eyebrow--center">Our Design Philosophy</div>
      <h2 class="dls-h2" style="font-size: clamp(2rem, 5vw, 3rem);">Why Choose a Custom Build<br /><span class="text-gradient-gold">from Dunn's?</span></h2>
      <p class="dls-muted" style="max-width: 36rem; margin: 1rem auto 0;">A true walk-in humidor is more than a cedar-lined room &mdash; it is a complex ecosystem. Our design philosophy rests on three pillars of luxury preservation.</p>
    </div>
    <div class="dls-grid-3">
      <div class="dls-card" style="position: relative;">
        <span class="wih-num">01</span>
        <div class="dls-icon-circle" style="margin-bottom: 1.5rem;">&#10052;</div>
        <h3 style="font-family: 'Playfair Display', serif; color: white; font-size: 1.25rem; margin: 0 0 0.75rem;">Advanced Climate Integration</h3>
        <p class="dls-muted" style="margin: 0;">We consult on industrial-grade humidification systems and specialised HVAC cooling to ensure consistent 70/70 conditions &mdash; even across large-scale spaces.</p>
      </div>
      <div class="dls-card" style="position: relative;">
        <span class="wih-num">02</span>
        <div class="dls-icon-circle" style="margin-bottom: 1.5rem;">&#127794;</div>
        <h3 style="font-family: 'Playfair Display', serif; color: white; font-size: 1.25rem; margin: 0 0 0.75rem;">Spanish Cedar Artistry</h3>
        <p class="dls-muted" style="margin: 0;">Only the finest sustainably sourced Spanish Cedar is used for shelving and wall lining &mdash; enhancing aging, regulating moisture, and guarding against tobacco beetles.</p>
      </div>
      <div class="dls-card" style="position: relative;">
        <span class="wih-num">03</span>
        <div class="dls-icon-circle" style="margin-bottom: 1.5rem;">&#10022;</div>
        <h3 style="font-family: 'Playfair Display', serif; color: white; font-size: 1.25rem; margin: 0 0 0.75rem;">Executive Aesthetic</h3>
        <p class="dls-muted" style="margin: 0;">From tempered glass entryways to custom LED accent lighting, we design spaces that are as visually stunning as they are functionally precise.</p>
      </div>
    </div>
  </div>
</section>

<!-- Capabilities -->
<section class="dls-page" style="background: var(--charcoal-900);">
  <div class="dls-container dls-container--wide">
    <div style="text-align: center; margin-bottom: 4rem;">
      <div class="dls-eyebrow dls-eyebrow--center">What We Build</div>
      <h2 class="dls-h2" style="font-size: clamp(2rem, 5vw, 3rem);">Our Custom <span class="text-gradient-gold">Capabilities</span></h2>
    </div>
    <div class="dls-grid-3">
      <div class="dls-card" style="background: var(--charcoal-950); padding: 0; overflow: hidden;">
        <div class="dls-topbar"></div>
        <div style="padding: 2rem;">
          <h3 style="font-family: 'Playfair Display', serif; color: white; font-size: 1.2rem; margin: 0 0 0.75rem;">Residential Cigar Rooms</h3>
          <p class="dls-muted" style="margin: 0 0 1.25rem;">Tailored to fit your home's unique architecture &mdash; from intimate studies to dedicated full-room sanctuaries.</p>
          <ul class="wih-features">
            <li>Custom floor-to-ceiling cedar lining</li>
            <li>Integrated humidification systems</li>
            <li>Bespoke shelving and display</li>
            <li>Ambient LED lighting design</li>
          </ul>
        </div>
      </div>
      <div class="dls-card" style="background: var(--charcoal-950); padding: 0; overflow: hidden;">
        <div class="dls-topbar"></div>
        <div style="padding: 2rem;">
          <h3 style="font-family: 'Playfair Display', serif; color: white; font-size: 1.2rem; margin: 0 0 0.75rem;">Retail &amp; Hospitality</h3>
          <p class="dls-muted" style="margin: 0 0 1.25rem;">High-traffic solutions built for cigar bars, lounges, golf clubs, and fine dining establishments.</p>
          <ul class="wih-features">
            <li>Commercial-grade climate control</li>
            <li>High-capacity storage configurations</li>
            <li>Tempered glass display walls</li>
            <li>POS and access integration</li>
          </ul>
        </div>
      </div>
      <div class="dls-card" style="background: var(--charcoal-950); padding: 0; overflow: hidden;">
        <div class="dls-topbar"></div>
        <div style="padding: 2rem;">
          <h3 style="font-family: 'Playfair Display', serif; color: white; font-size: 1.2rem; margin: 0 0 0.75rem;">Electronic Monitoring</h3>
          <p class="dls-muted" style="margin: 0 0 1.25rem;">Remote humidity and temperature tracking systems, accessible via smartphone from anywhere in the world.</p>
          <ul class="wih-features">
            <li>Real-time sensor dashboards</li>
            <li>Automated alert notifications</li>
            <li>Multi-zone climate logging</li>
            <li>App-based remote control</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Process -->
<section class="dls-page">
  <div class="dls-container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <div class="dls-eyebrow dls-eyebrow--center">Our Process</div>
      <h2 class="dls-h2" style="font-size: clamp(2rem, 5vw, 3rem);">From Vision to <span class="text-gradient-gold">Reality</span></h2>
    </div>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      {%- assign step_titles = 'Initial Consultation|Design & Specification|Material Procurement|Crafting & Shipping|Guided Installation & Handover' | split: '|' -%}
      {%- assign step_descs = 'Our executive sales team discusses your vision, reviews your space, and outlines the technical and aesthetic possibilities for your project.|We produce detailed design drawings, material specifications, and a comprehensive quote covering all aspects of the build.|Sustainably sourced Spanish Cedar, premium hardware, and climate systems are procured to exacting standards before construction begins.|Every component — cedar lining, shelving, climate systems, and lighting — is crafted to your specifications and shipped to your site as a complete, ready-to-install kit.|Your contractor or in-house team installs with our detailed drawings, step-by-step instructions, and remote support — through to calibrating systems to target conditions, with a full care guide.' | split: '|' -%}
      {%- for title in step_titles -%}
        <div class="dls-flex" style="gap: 1.5rem;">
          <div class="dls-step-num" style="width: 3rem; height: 3rem;">0{{ forloop.index }}</div>
          <div class="dls-card" style="flex: 1; background: var(--charcoal-900);">
            <h3 style="color: white; margin: 0 0 0.5rem;">{{ title }}</h3>
            <p class="dls-muted" style="margin: 0;">{{ step_descs[forloop.index0] }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="dls-page" style="background: var(--charcoal-900);">
  <div class="dls-container dls-container--narrow">
    <div style="text-align: center; margin-bottom: 3rem;">
      <div class="dls-eyebrow dls-eyebrow--center">FAQ</div>
      <h2 class="dls-h2" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">Common <span class="text-gradient-gold">Questions</span></h2>
    </div>
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      {%- assign wfaq_qs = 'Do you offer custom walk-in humidors nationwide?|How long does a bespoke walk-in humidor project take?|What size room do I need for a walk-in humidor?|Do you handle the installation?|What are the ongoing maintenance requirements?|Can you work with an existing room or space?' | split: '|' -%}
      {%- assign wfaq_as = 'Yes. We design custom walk-in humidors and ship every component across the United States — for private residences, cigar lounges, restaurants, and retail spaces. Every project begins with a complimentary consultation, and your build team installs with our detailed instructions and remote guidance.|Project timelines vary based on scope and complexity. Residential projects typically take 4–8 weeks from design sign-off to component delivery; commercial builds may range from 8–16 weeks. On-site installation time depends on your build team, and we provide a detailed schedule and guidance during the consultation phase.|Walk-in humidors can be built in spaces as small as a large closet (approximately 4×6 ft) or as grand as a full dedicated room. We assess your available space and design accordingly to maximise storage capacity and climate efficiency.|We manage design, engineering, material procurement, and manufacturing, then ship every component to your site as a complete kit. Installation itself is carried out by your contractor or in-house team — supported by our detailed drawings, step-by-step instructions, and remote guidance, with a single point of contact throughout the entire process.|Properly designed walk-in humidors require minimal maintenance. We provide a handover guide covering humidity system upkeep, cedar care, and seasonal calibration checks. Optional remote monitoring packages are available for hands-off management.|Absolutely. The majority of our projects involve converting existing rooms, closets, or custom-built additions. Our design team evaluates insulation, existing HVAC, and structural factors before recommending the optimal approach.' | split: '|' -%}
      {%- for q in wfaq_qs -%}
        <details class="dls-card" style="background: var(--charcoal-950); padding: 0;">
          <summary style="padding: 1.15rem 1.5rem; cursor: pointer; color: var(--cream-100); font-size: 0.9rem; font-weight: 500;">{{ q }}</summary>
          <p class="dls-muted" style="padding: 0 1.5rem 1.25rem; margin: 0;">{{ wfaq_as[forloop.index0] }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- Enquiry -->
<section class="dls-page" id="enquire">
  <div class="dls-container dls-container--narrow">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <div class="dls-eyebrow dls-eyebrow--center">Start Your Project</div>
      <h2 class="dls-h2" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">Request a <span class="text-gradient-gold">Free Consultation</span></h2>
      <p class="dls-muted" style="margin: 1rem 0 0;">Book a 30-minute call with Belle to discuss your custom walk-in humidor project. Or call <a href="tel:8884319214" class="dls-gold">(888) 431-9214</a>.</p>
    </div>

    <div class="dls-card" style="text-align: center; padding: 2.5rem;">
      <a href="https://calendly.com/belle-dunnluxuryselections/30min" target="_blank" class="btn btn-primary" style="display: inline-block;">
        Schedule Your Free Consultation
      </a>
    </div>
  </div>
</section>

