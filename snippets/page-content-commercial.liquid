{%- comment -%}
  Dunn's Commercial — Phase 2 B2B / trade division page. Targets lounges,
  clubs, hotels, restaurants, and developers. Same pre-install, made-to-spec
  model as bespoke. Enquiry form reuses the shared lead plumbing (Google
  Sheet + Chat + gtag), formType "commercial" — feeds the commission sales
  rep's wholesale lane. Routed via templates/page.liquid handle `commercial`.
  rev: image hero (cache bust)
{%- endcomment -%}

<!-- Hero -->
<section class="com-hero">
  <img src="{{ 'commercial-hero.webp' | asset_url }}" alt="A luxury cigar lounge with backlit humidor displays and leather seating, designed by Dunn's Luxury Selections" class="com-hero__img" width="1600" height="901" fetchpriority="high">
  <div class="com-hero__overlay"></div>
  <div class="dls-container com-hero__content">
    <div style="max-width:42rem;">
      <div class="dls-eyebrow">Commercial &amp; Trade</div>
      <h1 class="dls-h1" style="font-size:clamp(2.25rem,5.5vw,3.75rem);">Cigar environments for <span class="text-gradient-gold">lounges, clubs, and hospitality</span></h1>
      <p class="dls-lead" style="margin:1.25rem 0 2rem;font-size:1.15rem;">We design and build commercial-grade cigar storage and lounge environments for venues that treat cigars as an experience. Made to your space, shipped complete, and installed by your team with our guidance.</p>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;">
        <a href="#com-enquire" class="btn btn-primary">Discuss Your Venue</a>
        <a href="tel:8884319214" class="btn btn-secondary">&#9742; (888) 431-9214</a>
      </div>
    </div>
  </div>
</section>

<!-- Who we serve -->
<section class="dls-page" style="background:var(--charcoal-900);">
  <div class="dls-container dls-container--wide">
    <div style="text-align:center;margin-bottom:3rem;">
      <div class="dls-eyebrow dls-eyebrow--center">Who We Serve</div>
      <h2 class="dls-h2" style="font-size:clamp(1.75rem,4vw,2.5rem);">Built for high-traffic <span class="text-gradient-gold">hospitality</span></h2>
    </div>
    <div class="com-tags">
      {%- assign venues = 'Cigar lounges,Country clubs,Hotels &amp; resorts,Restaurants,High-end bars,Golf clubs,Private members clubs,Whiskey &amp; cigar lounges,Luxury residential developments' | split: ',' -%}
      {%- for v in venues -%}<span class="com-tag">{{ v }}</span>{%- endfor -%}
    </div>
  </div>
</section>

<!-- What we deliver -->
<section class="dls-page">
  <div class="dls-container dls-container--wide">
    <div style="text-align:center;margin-bottom:3rem;">
      <div class="dls-eyebrow dls-eyebrow--center">What We Deliver</div>
      <h2 class="dls-h2" style="font-size:clamp(2rem,5vw,3rem);">Commercial-grade, <span class="text-gradient-gold">end to end</span></h2>
    </div>
    <div class="dls-grid-3">
      <div class="dls-card">
        <div class="dls-icon-circle" style="margin-bottom:1.25rem;">&#10052;</div>
        <h3 style="font-family:'Playfair Display',serif;color:#fff;font-size:1.2rem;margin:0 0 .6rem;">Climate at Scale</h3>
        <p class="dls-muted" style="margin:0;">Commercial humidification and multi-zone cooling engineered to hold 70/70 across large, high-traffic spaces.</p>
      </div>
      <div class="dls-card">
        <div class="dls-icon-circle" style="margin-bottom:1.25rem;">&#128274;</div>
        <h3 style="font-family:'Playfair Display',serif;color:#fff;font-size:1.2rem;margin:0 0 .6rem;">Display &amp; Member Lockers</h3>
        <p class="dls-muted" style="margin:0;">Tempered glass display walls, high-capacity storage, and private member locker systems with access control.</p>
      </div>
      <div class="dls-card">
        <div class="dls-icon-circle" style="margin-bottom:1.25rem;">&#128225;</div>
        <h3 style="font-family:'Playfair Display',serif;color:#fff;font-size:1.2rem;margin:0 0 .6rem;">Monitoring &amp; Integration</h3>
        <p class="dls-muted" style="margin:0;">Real-time humidity and temperature dashboards, alerts, and options to integrate with POS and access systems.</p>
      </div>
    </div>
  </div>
</section>

<!-- How we work -->
<section class="dls-page" style="background:var(--charcoal-900);">
  <div class="dls-container">
    <div style="text-align:center;margin-bottom:3rem;">
      <div class="dls-eyebrow dls-eyebrow--center">How We Work With Venues</div>
      <h2 class="dls-h2" style="font-size:clamp(1.75rem,4vw,2.5rem);">Design here, <span class="text-gradient-gold">install on site</span></h2>
    </div>
    <div class="bsp-grid4">
      {%- assign ct = 'Consult,Design,Build,Install' | split: ',' -%}
      {%- assign cd = 'We review your space, capacity needs, and member experience, and outline the right approach.|Detailed drawings, specifications, and a full quote covering climate, cabinetry, and finishes.|Crafted to specification at our manufacturing center and shipped as a complete installation.|Your contractor installs with our drawings, instructions, and remote support, calibrated to target conditions.' | split: '|' -%}
      {%- for t in ct -%}
        <div class="dls-card" style="position:relative;">
          <span class="bsp-num">0{{ forloop.index }}</span>
          <h3 style="font-family:'Playfair Display',serif;color:#fff;font-size:1.1rem;margin:0 0 .6rem;">{{ t }}</h3>
          <p class="dls-muted" style="margin:0;font-size:.88rem;">{{ cd[forloop.index0] }}</p>
        </div>
      {%- endfor -%}
    </div>
    <p class="dls-muted" style="text-align:center;max-width:38rem;margin:2.5rem auto 0;font-size:.92rem;">Trade, wholesale, and multi-unit inquiries are welcome. We work with developers and hospitality groups on repeat and multi-location programs.</p>
  </div>
</section>

<!-- Enquiry -->
<section class="dls-page" id="com-enquire" style="scroll-margin-top:90px;">
  <div class="dls-container dls-container--narrow">
    <div style="text-align:center;margin-bottom:2.5rem;">
      <div class="dls-eyebrow dls-eyebrow--center">Discuss Your Venue</div>
      <h2 class="dls-h2" style="font-size:clamp(1.75rem,4vw,2.5rem);">Request a <span class="text-gradient-gold">commercial consultation</span></h2>
      <p class="dls-muted" style="margin:1rem 0 0;">Tell us about your space and a specialist will follow up to scope the project. Or call <a href="tel:8884319214" class="dls-gold">(888) 431-9214</a>.</p>
    </div>
    <div class="dls-card" style="padding:2.5rem;">
      <form class="dvf" data-form-type="commercial" novalidate>
        <div class="dvf-grid">
          <label class="dvf-label">Full name <span class="dvf-req">*</span><input class="dvf-input" name="name" required autocomplete="name"></label>
          <label class="dvf-label">Business or venue <span class="dvf-req">*</span><input class="dvf-input" name="business" required autocomplete="organization"></label>
          <label class="dvf-label">Email <span class="dvf-req">*</span><input class="dvf-input" name="email" type="email" required autocomplete="email"></label>
          <label class="dvf-label">Phone <span class="dvf-req">*</span><input class="dvf-input" name="phone" type="tel" required autocomplete="tel"></label>
          <label class="dvf-label">Venue type
            <select class="dvf-input" name="venueType">
              <option value="">Select one</option>
              <option>Cigar lounge</option>
              <option>Country or golf club</option>
              <option>Hotel or resort</option>
              <option>Restaurant or bar</option>
              <option>Private members club</option>
              <option>Residential development</option>
              <option>Other</option>
            </select>
          </label>
          <label class="dvf-label">City &amp; state<input class="dvf-input" name="location" placeholder="e.g. Miami, FL"></label>
          <label class="dvf-label dvf-full">Project details<textarea class="dvf-input" name="details" rows="4" placeholder="Space, capacity, timeline, number of locations..."></textarea></label>
        </div>
        <div class="dvf-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
        <div style="margin-top:1.5rem;text-align:center;">
          <button type="submit" class="btn btn-primary">Request a Consultation</button>
          <p class="dvf-msg" role="status" style="margin:.85rem 0 0;font-size:.85rem;"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .com-hero{position:relative;min-height:60vh;display:flex;align-items:center;overflow:hidden}
  .com-hero__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .com-hero__overlay{position:absolute;inset:0;background:linear-gradient(to right,rgba(20,17,16,.92),rgba(20,17,16,.7) 50%,rgba(20,17,16,.4))}
  .com-hero__content{position:relative;z-index:1;width:100%;padding-top:5rem;padding-bottom:5rem}
  .com-tags{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;max-width:52rem;margin:0 auto}
  .com-tag{border:1px solid rgba(201,138,16,.3);background:var(--charcoal-950,#0e0f12);color:rgba(240,221,184,.82);border-radius:100px;padding:.6rem 1.1rem;font-size:.9rem}
  .bsp-grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}
  @media(max-width:900px){.bsp-grid4{grid-template-columns:1fr 1fr}}
  @media(max-width:640px){.bsp-grid4{grid-template-columns:1fr}}
  .bsp-num{position:absolute;top:1.1rem;right:1.25rem;font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:rgba(164,108,12,.4);line-height:1}
  .dvf-grid{display:grid;grid-template-columns:1fr 1fr;gap:.25rem 1.25rem;text-align:left}
  @media(max-width:560px){.dvf-grid{grid-template-columns:1fr}}
  .dvf-label{display:block;color:rgba(240,221,184,.7);font-size:.85rem;margin-bottom:1rem}
  .dvf-req{color:var(--gold-400,#d4af37)}
  .dvf-full{grid-column:1/-1}
  .dvf-input{display:block;width:100%;box-sizing:border-box;margin-top:.35rem;padding:.75rem 1rem;background:var(--charcoal-950,#0e0f12);border:1px solid rgba(164,108,12,.3);border-radius:.35rem;color:var(--cream-100,#f5f1e8);font-family:inherit;font-size:.92rem}
  .dvf-input:focus{outline:none;border-color:var(--gold-500,#c9a227)}
  .dvf-hp{position:absolute;left:-9999px}
  .dvf-msg.err{color:#e08585}
  .dvf-ok{text-align:center}
  .dvf-ok .tick{width:3rem;height:3rem;margin:0 auto 1rem;border-radius:9999px;background:rgba(201,162,39,.15);color:var(--gold-400,#d4af37);display:flex;align-items:center;justify-content:center;font-size:1.5rem}
</style>

<script>
  (function () {
    var LEAD_ENDPOINT = 'https://script.google.com/macros/s/AKfycbw3bkr1qS8wJ7GrQeqhp4UytVlSMPwtacyG3IkD0dxNmi36YoX5jU-hcBpRPqe3m8Jq/exec';
    var CHAT_WEBHOOK = 'https://chat.googleapis.com/v1/spaces/AAQAJQZfKTI/messages?key=AIzaSyDdI0hCZtE6vySjMm-WEfRq3CPzqKqqsHI&token=qHgGguu_2oJoYXLqU6mV-aIVS9H7GUsE_veiGPzJ1pw';
    function pingChat(data){try{var m='*🏢 New Commercial Lead*';Object.keys(data).forEach(function(k){if(k==='website'||k==='formType')return;if(data[k])m+='\n*'+k.charAt(0).toUpperCase()+k.slice(1)+':* '+data[k];});fetch(CHAT_WEBHOOK,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:m})});}catch(e){}}
    function subscribeKlaviyo(name,business,email,pd){try{var parts=(name||'').trim().split(/\s+/);var fn=parts.shift()||'';var ln=parts.join(' ');var attrs={email:email,first_name:fn,last_name:ln,properties:{lead_source:'Commercial'}};if(pd)attrs.phone_number='+1'+pd;if(business)attrs.organization=business;fetch('https://a.klaviyo.com/client/subscriptions/?company_id=Wp37xM',{method:'POST',headers:{'Content-Type':'application/json',revision:'2024-10-15'},body:JSON.stringify({data:{type:'subscription',attributes:{custom_source:'Commercial Enquiry',profile:{data:{type:'profile',attributes:attrs}}},relationships:{list:{data:{type:'list',id:'YtqBkk'}}}}})});}catch(e){}}
    var form=document.querySelector('.dvf[data-form-type="commercial"]');
    if(!form)return;
    form.addEventListener('submit',function(e){
      e.preventDefault();
      var msg=form.querySelector('.dvf-msg');var btn=form.querySelector('button[type="submit"]');
      msg.textContent='';msg.classList.remove('err');
      var hp=form.querySelector('input[name="website"]');if(hp&&hp.value)return;
      var data={formType:'commercial'};
      new FormData(form).forEach(function(v,k){v=String(v).trim();if(v&&k!=='website')data[k]=v;});
      var emailOk=/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(data.email||'');
      var pd=(data.phone||'').replace(/\D/g,'').replace(/^1(\d{10})$/,'$1');
      var phoneOk=/^[2-9]\d{2}[2-9]\d{6}$/.test(pd)&&!/^(\d)\1{9}$/.test(pd);
      if(!data.name||!data.business){msg.textContent='Please enter your name and business.';msg.classList.add('err');return;}
      if(!emailOk){msg.textContent='Please enter a valid email address.';msg.classList.add('err');return;}
      if(!phoneOk){msg.textContent='Please enter a valid phone number.';msg.classList.add('err');return;}
      var label=btn.textContent;btn.disabled=true;btn.textContent='Sending…';
      fetch(LEAD_ENDPOINT,{method:'POST',mode:'no-cors',body:JSON.stringify(data)})
        .then(function(){
          pingChat(data);
          subscribeKlaviyo(data.name,data.business,data.email,pd);
          try{if(window.gtag)window.gtag('event','generate_lead',{value:1,currency:'USD',form_type:'commercial'});}catch(e){}
          var card=form.closest('.dls-card');
          if(card)card.innerHTML='<div class="dvf-ok"><div class="tick">&#10003;</div><h3 style="font-family:\'Playfair Display\',serif;color:#fff;margin:0 0 .5rem;">Thank you. Your inquiry is in.</h3><p class="dls-muted" style="margin:0;">A specialist will reach out to scope your project.</p></div>';
        })
        .catch(function(){msg.textContent='Something went wrong. Please call (888) 431-9214.';msg.classList.add('err');btn.disabled=false;btn.textContent=label;});
    });
  })();
</script>
