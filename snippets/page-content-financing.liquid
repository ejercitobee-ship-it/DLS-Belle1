{%- comment -%}Financing page content ported from the headless Financing.tsx.{%- endcomment -%}

<div class="dls-page">
  <!-- Hero -->
  <div class="dls-container" style="text-align: center; margin-bottom: 4rem;">
    <div class="dls-eyebrow dls-eyebrow--center">Flexible Financing</div>
    <h1 class="dls-h1">Own It Now. <span class="text-gradient-gold">Pay Over Time.</span></h1>
    <p class="dls-muted" style="max-width: 42rem; margin: 0 auto; font-size: 1rem;">Finance any qualifying purchase over $1,500 with Shop Pay Installments. Qualified buyers pay 0% interest — split into 4 equal monthly payments. Approval takes less than a minute at checkout.</p>
  </div>

  <!-- Why collectors finance -->
  <div class="dls-container" style="margin-bottom: 4rem;">
    <h2 class="dls-h2" style="text-align: center; margin-bottom: 2.5rem;">Why Serious Collectors Finance</h2>
    <div class="dls-grid-3">
      <div class="dls-card">
        <p class="dls-gold" style="font-weight: 600; font-size: 0.9rem; margin: 0 0 0.75rem;">Build Now, Cash Later</p>
        <p class="dls-muted" style="margin: 0;">Expand your collection today without depleting capital. Keep investments working while securing your pieces.</p>
      </div>
      <div class="dls-card">
        <p class="dls-gold" style="font-weight: 600; font-size: 0.9rem; margin: 0 0 0.75rem;">Zero Interest, Full Control</p>
        <p class="dls-muted" style="margin: 0;">0% APR on approved purchases. No hidden fees, no prepayment penalties. Pay early anytime.</p>
      </div>
      <div class="dls-card">
        <p class="dls-gold" style="font-weight: 600; font-size: 0.9rem; margin: 0 0 0.75rem;">Instant Approval, Same-Day Ship</p>
        <p class="dls-muted" style="margin: 0;">Real-time credit decision at checkout. Approved orders ship on normal schedule with expert concierge support.</p>
      </div>
    </div>
  </div>

  <!-- Shop Pay explainer -->
  <div class="dls-container" style="margin-bottom: 4rem;">
    <div class="dls-card dls-card--gold" style="padding: 2.5rem;">
      <h3 style="color: white; font-size: 1.15rem; margin: 0 0 1.25rem;">What is Shop Pay Installments?</h3>
      <p class="dls-muted" style="margin: 0 0 1.25rem;">Shop Pay Installments is a lending partnership between Shopify and Affirm's network of lenders. Affirm specializes in flexible, transparent lending for purchases from $0–$17,500+. Millions of shoppers use it across Shopify stores globally.</p>
      <div class="dls-grid-2">
        <div style="background: rgba(33, 30, 28, 0.5); border-radius: 0.5rem; padding: 1rem;">
          <p class="dls-gold" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.5rem;">The Approval Process</p>
          <p class="dls-muted" style="margin: 0;">Real-time credit decision using soft pull — checking eligibility doesn't affect your credit score.</p>
        </div>
        <div style="background: rgba(33, 30, 28, 0.5); border-radius: 0.5rem; padding: 1rem;">
          <p class="dls-gold" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.5rem;">Why 0% APR?</p>
          <p class="dls-muted" style="margin: 0;">Affirm earns through merchant fees, not interest. That model lets them offer 0% APR to qualified buyers.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- How it works -->
  <div class="dls-container dls-container--wide" style="margin-bottom: 4rem;">
    <h2 class="dls-h2" style="text-align: center; margin-bottom: 2.5rem;">How It Works</h2>
    <div class="dls-grid-4">
      <div class="dls-card">
        <div class="dls-step-num" style="margin-bottom: 1.25rem;">1</div>
        <h3 style="color: white; font-size: 0.95rem; margin: 0 0 0.75rem;">Add to Cart &amp; Check Out</h3>
        <p class="dls-muted" style="margin: 0; font-size: 0.85rem;">Shop as usual. At our secure Shopify checkout, choose "Shop Pay &middot; Pay in installments" as your payment method.</p>
      </div>
      <div class="dls-card">
        <div class="dls-step-num" style="margin-bottom: 1.25rem;">2</div>
        <h3 style="color: white; font-size: 0.95rem; margin: 0 0 0.75rem;">Get a Real-Time Decision</h3>
        <p class="dls-muted" style="margin: 0; font-size: 0.85rem;">Enter a few basic details for an instant eligibility check. Checking your eligibility will not affect your credit score.</p>
      </div>
      <div class="dls-card">
        <div class="dls-step-num" style="margin-bottom: 1.25rem;">3</div>
        <h3 style="color: white; font-size: 0.95rem; margin: 0 0 0.75rem;">Split Your Purchase</h3>
        <p class="dls-muted" style="margin: 0; font-size: 0.85rem;">Qualified buyers can split purchases into 4 payments at 0% interest. No hidden fees, no surprises.</p>
      </div>
      <div class="dls-card">
        <div class="dls-step-num" style="margin-bottom: 1.25rem;">4</div>
        <h3 style="color: white; font-size: 0.95rem; margin: 0 0 0.75rem;">Enjoy Your Humidor Now</h3>
        <p class="dls-muted" style="margin: 0; font-size: 0.85rem;">Your order ships on the normal schedule — expert concierge support included on cabinet and electronic humidors.</p>
      </div>
    </div>
  </div>

  <!-- Payment examples -->
  <div class="dls-container" style="margin-bottom: 4rem;">
    <div class="dls-card dls-card--gold" style="padding: 2.5rem;">
      <h2 class="dls-h2" style="text-align: center; margin-bottom: 0.75rem;">Real-World Payment Examples</h2>
      <p class="dls-muted" style="text-align: center; margin: 0 0 2.5rem;">See how financing works for different collection levels</p>
      <div class="dls-grid-3">
        <div class="dls-card" style="background: var(--charcoal-950); text-align: center;">
          <p class="dls-gold" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.5rem;">Entry-Level Collection</p>
          <p style="color: white; font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.25rem; margin: 0 0 1rem;">$2,352</p>
          <p style="color: var(--gold-300); font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.5rem; margin: 0;">$588<span class="dls-muted" style="font-family: Inter, sans-serif; font-weight: 400; font-size: 0.85rem;">/month</span></p>
          <p class="dls-muted" style="font-size: 0.75rem; margin: 0.75rem 0 0;">Perfect for your first desktop or travel humidor</p>
        </div>
        <div class="dls-card" style="background: var(--charcoal-950); text-align: center; border-color: rgba(201, 138, 16, 0.4);">
          <p class="dls-gold" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.5rem;">Premium Cabinet</p>
          <p style="color: white; font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.25rem; margin: 0 0 1rem;">$4,752</p>
          <p style="color: var(--gold-300); font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.5rem; margin: 0;">$1,188<span class="dls-muted" style="font-family: Inter, sans-serif; font-weight: 400; font-size: 0.85rem;">/month</span></p>
          <p class="dls-muted" style="font-size: 0.75rem; margin: 0.75rem 0 0;">Cabinet installations &amp; electronic humidors</p>
        </div>
        <div class="dls-card" style="background: var(--charcoal-950); text-align: center;">
          <p class="dls-gold" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.5rem;">Luxury Investment</p>
          <p style="color: white; font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.25rem; margin: 0 0 1rem;">$6,387</p>
          <p style="color: var(--gold-300); font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.5rem; margin: 0;">$1,597<span class="dls-muted" style="font-family: Inter, sans-serif; font-weight: 400; font-size: 0.85rem;">/month</span></p>
          <p class="dls-muted" style="font-size: 0.75rem; margin: 0.75rem 0 0;">Premium walk-in sanctuaries &amp; collection builds</p>
        </div>
      </div>
      <p class="dls-muted" style="font-size: 0.7rem; text-align: center; margin: 1.5rem 0 0; opacity: 0.7;">Payment options through Shop Pay Installments are subject to an eligibility check and approval, and are provided by Affirm's lending partners. Estimated payments shown are illustrative; your exact terms are confirmed at checkout before you commit. Longer-term plans may also be available for larger purchases.</p>
    </div>
  </div>

  <!-- Testimonial -->
  <div class="dls-container dls-container--narrow" style="margin-bottom: 4rem;">
    <div class="dls-card dls-card--gold" style="text-align: center; font-style: italic; padding: 2.5rem;">
      <p class="dls-muted" style="font-size: 1.05rem; margin: 0 0 1.5rem;">"I financed my walk-in build so I could complete the project now and keep my cash reserves intact. The approval was instant, and the monthly payments fit perfectly into my budget. Best part? Zero interest, zero surprises."</p>
      <p class="dls-gold" style="font-weight: 600; font-style: normal; margin: 0;">Marcus T., Collector</p>
      <p class="dls-muted" style="font-size: 0.85rem; font-style: normal; margin: 0.25rem 0 0;">Walk-In Sanctuary, $6,200 financed</p>
    </div>
  </div>

  <!-- FAQ -->
  <div class="dls-container dls-container--narrow" style="margin-bottom: 4rem;">
    <h2 class="dls-h2" style="text-align: center; margin-bottom: 2.5rem;">Financing FAQ</h2>
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      {%- assign faq_qs = 'What payment methods do you accept?|How does Shop Pay installment payment work?|Do I need a Shop Pay account?|Is there interest or hidden fees?|Is Shop Pay financing available on all products?|Can I pay early with no penalty?' | split: '|' -%}
      {%- assign faq_as = 'We accept all major credit cards, debit cards, and Shop Pay. With Shop Pay, you can pay in 4 interest-free installments on purchases over $1,500.|Shop Pay Installments lets you split your purchase into 4 equal monthly payments. Qualified buyers pay 0% interest with no hidden fees, and approval takes less than a minute at checkout.|No account needed. Shop Pay is available at checkout for eligible purchases. You can pay with any major credit or debit card.|No. Shop Pay installments are 100% interest-free for qualified buyers with no hidden fees. What you see at checkout is exactly what you pay.|Shop Pay installments are available on most products $1,500 and above. Check your product page or at checkout to see if your item qualifies.|Yes. You can pay off your installments early at any time without penalty or additional fees.' | split: '|' -%}
      {%- for q in faq_qs -%}
        <details class="dls-card" style="padding: 0;">
          <summary style="padding: 1rem 1.25rem; cursor: pointer; color: var(--cream-100); font-size: 0.9rem; font-weight: 500;">{{ q }}</summary>
          <p class="dls-muted" style="padding: 0 1.25rem 1rem; margin: 0;">{{ faq_as[forloop.index0] }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>

  <!-- CTA -->
  <div class="dls-container dls-container--narrow" style="text-align: center;">
    <h2 class="dls-h2" style="margin-bottom: 0.75rem;">Questions About Financing?</h2>
    <p class="dls-muted" style="margin: 0 0 1.5rem;">Our specialists are happy to walk you through payment options before you order. Call <a href="tel:8884319214" class="dls-gold">(888) 431-9214</a> or email <a href="mailto:support@dunnluxuryselections.com" class="dls-gold">support@dunnluxuryselections.com</a>.</p>
    <a href="/collections/all" class="btn btn-primary">Browse Collections</a>
    <p class="dls-muted" style="font-size: 0.75rem; margin-top: 1rem;">Mon&ndash;Fri, 9:00 AM &ndash; 6:00 PM CST</p>
  </div>
</div>

<!-- FAQPage schema (mirrors the headless prerendered schema for /financing) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question", "name": "What payment methods do you accept?", "acceptedAnswer": {"@type": "Answer", "text": "We accept all major credit cards, debit cards, and Shop Pay. With Shop Pay, you can pay in 4 interest-free installments on purchases over $1,500."}},
    {"@type": "Question", "name": "How does Shop Pay installment payment work?", "acceptedAnswer": {"@type": "Answer", "text": "Shop Pay Installments lets you split your purchase into 4 equal monthly payments. Qualified buyers pay 0% interest with no hidden fees, and approval takes less than a minute at checkout."}},
    {"@type": "Question", "name": "Do I need a Shop Pay account?", "acceptedAnswer": {"@type": "Answer", "text": "No account needed. Shop Pay is available at checkout for eligible purchases. You can pay with any major credit or debit card."}},
    {"@type": "Question", "name": "Is there interest or hidden fees?", "acceptedAnswer": {"@type": "Answer", "text": "No. Shop Pay installments are 100% interest-free for qualified buyers with no hidden fees. What you see at checkout is exactly what you pay."}},
    {"@type": "Question", "name": "Is Shop Pay financing available on all products?", "acceptedAnswer": {"@type": "Answer", "text": "Shop Pay installments are available on most products $1,500 and above. Check your product page or at checkout to see if your item qualifies."}},
    {"@type": "Question", "name": "Can I pay early with no penalty?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. You can pay off your installments early at any time without penalty or additional fees."}}
  ]
}
</script>
