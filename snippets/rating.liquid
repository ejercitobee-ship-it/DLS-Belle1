{%- comment -%}
  Star rating component

  Usage:
  {% render 'rating', rating: 4.5, size: 'sm' %}
  {% render 'rating', rating: 5, size: 'lg', count: 12 %}
{%- endcomment -%}

{%- liquid
  assign rating = rating | default: 5 | round
  assign size = size | default: 'md'
  assign size_px = 'text-base'
  if size == 'sm'
    assign size_px = 'text-xs'
  elsif size == 'lg'
    assign size_px = 'text-lg'
  endif
%}

<div class="rating-container {{ size_px }}">
  <div class="rating-stars">
    {%- for i in (1..5) -%}
      <svg
        class="star {% if i <= rating %}filled{% endif %}"
        width="1em"
        height="1em"
        viewBox="0 0 20 20"
        fill="{% if i <= rating %}currentColor{% else %}none{% endif %}"
        stroke="currentColor"
      >
        <path d="M10 1l3.09 6.26L20 7.24l-5 4.87 1.18 6.88L10 15.77l-6.18 3.25L5 12.11 0 7.24l6.91-1.01L10 1z" />
      </svg>
    {%- endfor -%}
  </div>

  {%- if count -%}
    <span class="rating-count">({{ count }} reviews)</span>
  {%- endif -%}
</div>

<style>
  .rating-stars {
    display: inline-flex;
    gap: 0.125em;
    color: var(--gold-500);
  }

  .rating-stars .star.filled {
    fill: var(--gold-500);
  }

  .rating-container {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .rating-count {
    color: rgba(240, 221, 184, 0.5);
    font-size: 0.85em;
  }
</style>
