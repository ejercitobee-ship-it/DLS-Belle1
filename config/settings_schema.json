[
  {
    "name": "Theme",
    "settings": [
      {
        "type": "header",
        "content": "Store Information"
      },
      {
        "type": "text",
        "id": "store_name",
        "label": "Store Name",
        "default": "Dunn's Luxury Selections"
      },
      {
        "type": "textarea",
        "id": "store_description",
        "label": "Store Description",
        "default": "America's premier destination for luxury humidors."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Color Scheme"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Color (Gold)",
        "default": "#e5a524"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary Color (Charcoal)",
        "default": "#211e1c"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent Color (Cream)",
        "default": "#f8f0e0"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text Color",
        "default": "#f8f0e0"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border Color",
        "default": "#463e3b"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "playfair_display_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "header",
        "content": "Logo & Navigation"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo Width (px)",
        "min": 100,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 200
      },
      {
        "type": "link_list",
        "id": "menu_main",
        "label": "Main Menu"
      },
      {
        "type": "header",
        "content": "Header Styling"
      },
      {
        "type": "color",
        "id": "header_background",
        "label": "Header Background Color",
        "default": "#211e1c"
      },
      {
        "type": "color",
        "id": "header_text_color",
        "label": "Navigation Text Color",
        "default": "#f8f0e0"
      },
      {
        "type": "color",
        "id": "header_text_hover",
        "label": "Navigation Hover Color",
        "default": "#e5a524"
      },
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Sticky Header",
        "default": true
      }
    ]
  },
  {
    "name": "Home Page",
    "settings": [
      {
        "type": "header",
        "content": "Hero Section"
      },
      {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Hero Image"
      },
      {
        "type": "text",
        "id": "hero_title",
        "label": "Hero Title",
        "default": "Luxury Humidors for Connoisseurs"
      },
      {
        "type": "textarea",
        "id": "hero_subtitle",
        "label": "Hero Subtitle",
        "default": "Precision climate-controlled storage for your finest cigars"
      },
      {
        "type": "text",
        "id": "hero_cta_text",
        "label": "Hero CTA Button Text",
        "default": "Shop Collection"
      },
      {
        "type": "url",
        "id": "hero_cta_url",
        "label": "Hero CTA URL",
        "default": "/collections/all"
      },
      {
        "type": "header",
        "content": "Featured Products Section"
      },
      {
        "type": "collection",
        "id": "featured_collection",
        "label": "Featured Collection"
      },
      {
        "type": "range",
        "id": "featured_products_count",
        "label": "Number of Products to Show",
        "min": 3,
        "max": 12,
        "step": 1,
        "default": 3
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "header",
        "content": "Footer Content"
      },
      {
        "type": "textarea",
        "id": "footer_about",
        "label": "About Text",
        "default": "America's premier destination for luxury humidors. Precision, prestige, and presence."
      },
      {
        "type": "link_list",
        "id": "footer_menu_1",
        "label": "Footer Menu 1 (Collections)"
      },
      {
        "type": "link_list",
        "id": "footer_menu_2",
        "label": "Footer Menu 2 (Customer Service)"
      },
      {
        "type": "link_list",
        "id": "footer_menu_3",
        "label": "Footer Menu 3 (Legal)"
      },
      {
        "type": "checkbox",
        "id": "show_newsletter",
        "label": "Show Newsletter Signup",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_social_icons",
        "label": "Show Social Media Icons",
        "default": true
      }
    ]
  },
  {
    "name": "Checkout",
    "settings": [
      {
        "type": "header",
        "content": "Shop Pay Installments"
      },
      {
        "type": "checkbox",
        "id": "enable_shop_pay_messaging",
        "label": "Enable Shop Pay Installments Messaging",
        "default": true
      },
      {
        "type": "text",
        "id": "shop_pay_minimum",
        "label": "Shop Pay Minimum Purchase Amount",
        "default": "1500"
      },
      {
        "type": "text",
        "id": "shop_pay_promo_text",
        "label": "Shop Pay Promo Text",
        "default": "Finance your purchase in 4 interest-free payments with Shop Pay."
      }
    ]
  },
  {
    "name": "Analytics",
    "settings": [
      {
        "type": "header",
        "content": "Google Analytics & Conversion Tracking"
      },
      {
        "type": "text",
        "id": "google_analytics_id",
        "label": "Google Analytics 4 ID (G-XXXXXXXX)",
        "default": "G-BG9K5QSYQQ"
      },
      {
        "type": "text",
        "id": "google_ads_id",
        "label": "Google Ads Customer ID (AW-XXXXXXXXXX)",
        "default": "AW-17833894840"
      },
      {
        "type": "text",
        "id": "google_tag_id",
        "label": "Google Tag Manager ID (GT-XXXXXXXXX)",
        "default": "GT-55VCHDDF"
      },
      {
        "type": "text",
        "id": "google_ads_conversion_label",
        "label": "Google Ads Conversion Label",
        "info": "Update if conversion label is rotated"
      }
    ]
  }
]
