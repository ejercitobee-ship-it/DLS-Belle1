{% stylesheet %}
  .page-hero {
    @apply relative w-full h-48 md:h-64 bg-gradient-to-r from-charcoal-900 to-charcoal-800 overflow-hidden;
  }

  .page-hero-content {
    @apply absolute inset-0 flex flex-col items-center justify-center text-center px-4;
    background: linear-gradient(135deg, rgba(33, 30, 28, 0.7) 0%, rgba(70, 62, 59, 0.7) 100%);
  }

  .page-hero h1 {
    @apply font-serif text-3xl md:text-5xl font-700 text-white;
  }

  .page-container {
    @apply max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16;
  }

  .page-content {
    @apply prose prose-invert max-w-none;
    background: transparent;
  }

  .page-content h2,
  .page-content h3,
  .page-content h4,
  .page-content h5,
  .page-content h6 {
    @apply font-serif font-700 mt-8 mb-4 text-white;
  }

  .page-content p {
    @apply text-cream-200/80 mb-4 leading-relaxed;
  }

  .page-content a {
    @apply text-gold-400 hover:text-gold-300 underline underline-offset-2;
  }

  .page-content ul,
  .page-content ol {
    @apply mb-4 pl-6 space-y-2;
  }

  .page-content li {
    @apply text-cream-200/80;
  }

  .page-content blockquote {
    @apply border-l-4 border-gold-500 pl-4 italic text-cream-200/70 my-6;
  }

  .page-content strong {
    @apply text-white font-semibold;
  }

  .page-content em {
    @apply italic text-cream-200/70;
  }

  .back-link {
    @apply text-gold-400 hover:text-gold-300 flex items-center gap-2 mb-8 font-semibold;
    text-decoration: none;
  }

  .back-link:hover {
    @apply translate-x-1 transition-transform;
  }

  .financing-table {
    @apply w-full mt-6 border-collapse;
  }

  .financing-table th,
  .financing-table td {
    @apply border border-charcoal-800/40 px-4 py-3 text-left;
  }

  .financing-table th {
    @apply bg-charcoal-900 font-semibold text-white;
  }

  .financing-table tr:hover {
    @apply bg-charcoal-900/50;
  }

  .financing-cta {
    @apply mt-8 inline-block px-6 py-3 bg-gold-500 text-charcoal-950 font-bold rounded hover:bg-gold-400 transition-all active:scale-95;
  }
{% endstylesheet %}

<!-- Page Hero -->
<section class="page-hero">
  <div class="page-hero-content">
    <h1>{{ page.title }}</h1>
  </div>
</section>

<!-- Page Content -->
<div class="page-container">
  <a href="/" class="back-link">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Home
  </a>

  <div class="page-content">
    {{ page.content }}
  </div>

  <!-- Financing-Specific CTA -->
  {% if page.handle == 'financing' %}
