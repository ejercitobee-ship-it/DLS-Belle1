{% stylesheet %}
  .collection-hero {
    @apply relative w-full h-64 md:h-80 bg-gradient-to-r from-charcoal-900 to-charcoal-800 overflow-hidden;
  }

  .collection-hero-content {
    @apply absolute inset-0 flex flex-col items-center justify-center text-center px-4;
    background: linear-gradient(135deg, rgba(33, 30, 28, 0.7) 0%, rgba(70, 62, 59, 0.7) 100%);
  }

  .collection-hero h1 {
    @apply font-serif text-3xl md:text-5xl font-700 text-white mb-2 leading-tight;
  }

  .collection-hero p {
    @apply text-cream-200/80 text-lg;
  }

  .collection-container {
    @apply max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16;
  }

  .filters-and-products {
    @apply grid grid-cols-1 md:grid-cols-4 gap-8;
  }

  .filters-sidebar {
    @apply md:col-span-1;
  }

  .filter-group {
    @apply mb-8 pb-8 border-b border-charcoal-800/40;
  }

  .filter-group:last-child {
    @apply border-b-0;
  }

  .filter-title {
    @apply font-semibold text-white text-sm mb-4;
  }

  .filter-options {
    @apply space-y-3;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .filter-option {
    @apply flex items-center;
  }

  .filter-option input[type="checkbox"] {
    @apply w-4 h-4 rounded border-charcoal-700 bg-charcoal-900 checked:bg-gold-500 checked:border-gold-500 cursor-pointer;
  }

  .filter-option label {
    @apply ml-3 text-cream-200/70 text-sm cursor-pointer hover:text-cream-200;
  }

  .sort-container {
    @apply mb-6 flex items-center justify-between;
  }

  .sort-label {
    @apply text-cream-200/70 text-sm;
  }

  .sort-select {
    @apply px-3 py-2 bg-charcoal-900 border border-charcoal-700 rounded text-white text-sm focus:outline-none focus:border-gold-500/60;
  }

  .products-section {
    @apply md:col-span-3;
  }

  .product-count {
    @apply text-cream-200/60 text-sm mb-6;
  }

  .product-grid {
    @apply grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6;
  }

  .product-card {
    @apply group relative rounded overflow-hidden bg-charcoal-900 border border-charcoal-800/40 hover:border-gold-500/40 transition-all hover:-translate-y-1;
  }

  .product-image {
    @apply w-full h-64 object-cover bg-charcoal-800;
  }

  .product-content {
    @apply p-4;
  }

  .product-title {
    @apply font-serif text-lg font-600 text-white mb-2 line-clamp-2;
  }

  .product-price {
    @apply text-gold-400 font-semibold mb-3;
  }

  .product-desc {
    @apply text-cream-200/60 text-sm line-clamp-2 mb-4;
  }

  .product-cta {
    @apply inline-block px-4 py-2 border border-gold-500/60 text-gold-400 hover:bg-gold-500/10 rounded text-sm font-semibold transition-all;
  }

  .empty-state {
    @apply text-center py-16;
  }

  .empty-icon {
    @apply w-16 h-16 mx-auto mb-4 text-charcoal-700;
  }

  .empty-title {
    @apply font-serif text-2xl font-600 text-white mb-2;
  }

  .empty-desc {
    @apply text-cream-200/60 mb-6;
  }

  .pagination {
    @apply mt-12 flex items-center justify-center gap-2;
  }

  .pagination a,
  .pagination span {
    @apply w-10 h-10 flex items-center justify-center rounded border border-charcoal-700 text-cream-200/70 text-sm;
  }

  .pagination a:hover {
    @apply border-gold-500/40 text-gold-400;
  }

  .pagination .current {
    @apply bg-gold-500/10 border-gold-500 text-gold-400 font-semibold;
  }
{% endstylesheet %}

<!-- Collection Hero -->
<section class="collection-hero">
  <div class="collection-hero-content">
    <h1>{{ collection.title }}</h1>
    {% if collection.description %}
      <p>{{ collection.description | strip_html | truncate: 150 }}</p>
    {% endif %}
  </div>
</section>

<!-- Filters & Products -->
<div class="collection-container">
  <div class="filters-and-products">
    <!-- Sidebar Filters -->
    <aside class="filters-sidebar">
      <!-- Sort -->
      <div class="sort-container">
        <label class="sort-label">Sort by</label>
        <select class="sort-select" onchange="window.location = this.value">
          <option value="{{ collection.url }}">Featured</option>
          <option value="{{ collection.url }}?sort_by=best-selling">Best Selling</option>
          <option value="{{ collection.url }}?sort_by=title-ascending">A - Z</option>
          <option value="{{ collection.url }}?sort_by=title-descending">Z - A</option>
          <option value="{{ collection.url }}?sort_by=price-ascending">Low to High</option>
          <option value="{{ collection.url }}?sort_by=price-descending">High to Low</option>
          <option value="{{ collection.url }}?sort_by=created-descending">Newest</option>
        </select>
      </div>

      <!-- Filter: Price (basic example) -->
      <div class="filter-group">
        <h3 class="filter-title">Price Range</h3>
        <ul class="filter-options">
          <li class="filter-option">
            <input type="checkbox" id="price-0" />
            <label for="price-0">Under $1,000</label>
          </li>
          <li class="filter-option">
            <input type="checkbox" id="price-1" />
            <label for="price-1">$1,000 - $2,000</label>
          </li>
          <li class="filter-option">
            <input type="checkbox" id="price-2" />
            <label for="price-2">$2,000 - $5,000</label>
          </li>
          <li class="filter-option">
            <input type="checkbox" id="price-3" />
            <label for="price-3">$5,000+</label>
          </li>
        </ul>
      </div>

      <!-- Filter: Availability -->
      <div class="filter-group">
        <h3 class="filter-title">Availability</h3>
        <ul class="filter-options">
          <li class="filter-option">
            <input type="checkbox" id="in-stock" checked />
            <label for="in-stock">In Stock</label>
          </li>
          <li class="filter-option">
            <input type="checkbox" id="out-of-stock" />
            <label for="out-of-stock">Out of Stock</label>
          </li>
        </ul>
      </div>
    </aside>

    <!-- Products -->
    <div class="products-section">
      {% if collection.products.size > 0 %}
        <p class="product-count">
          Showing {{ collection.products.size }} product{{ collection.products.size | pluralize }}
        </p>

        <div class="product-grid">
          {% for product in collection.products %}
            <a href="{{ product.url }}" class="product-card">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | img_url: '400x300' }}"
                  alt="{{ product.title }}"
                  class="product-image"
                />
              {% else %}
                <div class="product-image bg-charcoal-800"></div>
              {% endif %}

              <div class="product-content">
                <h3 class="product-title">{{ product.title }}</h3>

                <div class="product-price">
                  {% if product.price_min == product.price_max %}
                    {{ product.price_min | money }}
                  {% else %}
                    {{ product.price_min | money }} - {{ product.price_max | money }}
                  {% endif %}
                </div>

                <p class="product-desc">
                  {{ product.description | strip_html }}
                </p>

                {% if product.available %}
                  <span class="product-cta">Shop Now →</span>
                {% else %}
                  <span class="product-cta opacity-50">Out of Stock</span>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>

        <!-- Pagination (basic example) -->
        {% if paginate.pages > 1 %}
          <div class="pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}">← Previous</a>
            {% endif %}

            {% for page in paginate.parts %}
              {% if page.is_link %}
                <a href="{{ page.url }}">{{ page.title }}</a>
              {% else %}
                <span class="current">{{ page.title }}</span>
              {% endif %}
            {% endfor %}

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}">Next →</a>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <!-- Empty State -->
        <div class="empty-state">
          <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
          </svg>
          <h2 class="empty-title">No products found</h2>
          <p class="empty-desc">
            We couldn't find any products matching your filters. Try adjusting your search or browse our other collections.
          </p>
          <a href="/collections" class="inline-block px-6 py-2 bg-gold-500 text-charcoal-950 font-semibold rounded hover:bg-gold-400 transition-all">
            View All Collections
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% paginate collection.products by 12 %}
  <!-- Products rendered above inside the paginate block -->
{% endpaginate %}
